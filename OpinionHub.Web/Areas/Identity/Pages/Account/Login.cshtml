@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2">
        <i class="bi bi-box-arrow-in-right"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">Войдите, чтобы голосовать, оставлять комментарии и создавать опросы.</p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4">
            <form id="account" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.Login" class="form-label">Логин или Почта</label>
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" aria-required="true" />
                    <span asp-validation-for="Input.Login" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Пароль</label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label ms-1" asp-for="Input.RememberMe"></label>
                </div>

                <button id="login-submit" type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                </button>

                <div class="mt-3 d-flex justify-content-between flex-wrap gap-2 small">
                    <a id="forgot-password" asp-page="./ForgotPassword">Забыли пароль?</a>
                    <a asp-page="./ResendEmailConfirmation">Повторно отправить подтверждение</a>
                </div>

                <div class="mt-3 text-center small text-secondary">
                    Нет аккаунта?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Зарегистрироваться</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
