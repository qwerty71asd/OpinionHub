@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.Manage.DeletePersonalDataModel
@{
    ViewData["Title"] = "Удалить аккаунт";
}

<h2 class="oh-section-title"><i class="bi bi-trash3 text-danger"></i>Удалить аккаунт</h2>

<div class="alert alert-danger small">
    <i class="bi bi-exclamation-triangle-fill me-1"></i>
    Удаление аккаунта <strong>необратимо</strong>. Вместе с ним будут удалены ваши опросы,
    голоса, комментарии, лайки и подписки. Восстановить данные после удаления невозможно.
</div>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    @if (Model.RequirePassword)
    {
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger small"></span>
        </div>
    }

    <div class="d-flex gap-2 flex-wrap">
        <a asp-page="./PersonalData" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Отмена
        </a>
        <button type="submit" class="btn btn-danger flex-fill">
            <i class="bi bi-trash3 me-1"></i>Удалить аккаунт навсегда
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
