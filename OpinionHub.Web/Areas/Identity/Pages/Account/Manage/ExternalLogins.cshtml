@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.Manage.ExternalLoginsModel
@{
    ViewData["Title"] = "Внешние входы";
}

<h2 class="oh-section-title"><i class="bi bi-box-arrow-in-right"></i>Внешние входы</h2>

@if (Model.CurrentLogins.Count == 0 && !Model.OtherLogins.Any())
{
    <div class="alert alert-info small mb-0">
        Сейчас внешние провайдеры (Google, GitHub, …) в этом учебном проекте не сконфигурированы.
        Войти можно только по email и паролю.
    </div>
}
else
{
    @if (Model.CurrentLogins.Count > 0)
    {
        <h3 class="h6 text-secondary mt-2 mb-2">Текущие привязки</h3>
        <div class="table-responsive mb-3">
            <table class="table table-sm align-middle mb-0">
                <tbody>
                @foreach (var login in Model.CurrentLogins)
                {
                    <tr>
                        <td class="fw-medium">@(login.ProviderDisplayName ?? login.LoginProvider)</td>
                        <td class="text-end">
                            @if (Model.ShowRemoveButton)
                            {
                                <form method="post" asp-page-handler="RemoveLogin" class="d-inline">
                                    <input type="hidden" name="LoginProvider" value="@login.LoginProvider" />
                                    <input type="hidden" name="ProviderKey" value="@login.ProviderKey" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x-lg me-1"></i>Отвязать
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (Model.OtherLogins.Any())
    {
        <h3 class="h6 text-secondary mt-2 mb-2">Доступно для привязки</h3>
        <form id="link-login-form" method="post" asp-page-handler="LinkLogin" class="d-flex flex-wrap gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button type="submit"
                        class="btn btn-outline-primary"
                        name="provider"
                        value="@provider.Name"
                        title="Войти через @provider.DisplayName">
                    @provider.DisplayName
                </button>
            }
        </form>
    }
}
