@{
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="container oh-page oh-page--wide">
    <h1 class="h3 oh-page-title mb-3">
        <i class="bi bi-gear"></i>Настройки аккаунта
    </h1>
    <partial name="_ManageNav" />
    <div class="card border-0 shadow-sm oh-card mt-3">
        <div class="card-body p-4">
            @if (TempData["StatusMessage"] is string sm && !string.IsNullOrWhiteSpace(sm))
            {
                <div class="alert alert-info py-2 small mb-3">@sm</div>
            }
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/manage-nav.js" asp-append-version="true"></script>
}
