@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.Manage.ConfirmEmailChangeModel
@{
    ViewData["Title"] = "Подтверждение email";
}

<h2 class="oh-section-title"><i class="bi bi-envelope-check"></i>Подтверждение нового email</h2>

<p class="text-secondary small mb-3">
    Мы отправили 6-значный код на <strong>@Model.PendingEmail</strong>. Введите его ниже.
</p>

<form method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="Input.Code" class="form-label">Код подтверждения</label>
        <input asp-for="Input.Code" class="form-control text-center oh-code-input"
               inputmode="numeric" autocomplete="one-time-code" />
        <span asp-validation-for="Input.Code" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">
        <i class="bi bi-check2-circle me-1"></i>Подтвердить
    </button>
</form>

<form method="post" asp-page-handler="Resend" class="mt-3">
    <button type="submit" class="btn btn-outline-secondary w-100">
        <i class="bi bi-arrow-clockwise me-1"></i>Отправить код ещё раз
    </button>
</form>

<style>
    .oh-code-input { letter-spacing: .25rem; font-size: 1.1rem; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
