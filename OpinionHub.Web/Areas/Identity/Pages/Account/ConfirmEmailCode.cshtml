@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.ConfirmEmailCodeModel
@{
    ViewData["Title"] = "Подтверждение почты";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2">
        <i class="bi bi-envelope-check"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">
        Мы отправили 6-значный код на <strong>@Model.EmailMasked</strong>. Введите его ниже.
    </p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4">
            @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
            {
                <div class="alert alert-info py-2 small mb-3">@Model.StatusMessage</div>
            }

            <form method="post" novalidate>
                <input type="hidden" name="userId" value="@Model.UserId" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="mb-3">
                    <label asp-for="Input.Code" class="form-label">Код подтверждения</label>
                    <input asp-for="Input.Code" class="form-control text-center oh-code-input"
                           inputmode="numeric" autocomplete="one-time-code" />
                    <span asp-validation-for="Input.Code" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-check2-circle me-1"></i>Подтвердить
                </button>
            </form>

            <form method="post" asp-page-handler="Resend" class="mt-3">
                <input type="hidden" name="userId" value="@Model.UserId" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i>Отправить код ещё раз
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .oh-code-input { letter-spacing: .25rem; font-size: 1.1rem; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
