@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Пароль обновлён";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2 text-success">
        <i class="bi bi-check2-circle"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">Пароль успешно изменён.</p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4 text-center">
            <div class="mb-3"><i class="bi bi-check2-circle display-4 text-success"></i></div>
            <p class="text-secondary small mb-4">Теперь вы можете войти с новым паролем.</p>
            <a asp-page="./Login" class="btn btn-primary btn-lg w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i>Войти
            </a>
        </div>
    </div>
</div>
