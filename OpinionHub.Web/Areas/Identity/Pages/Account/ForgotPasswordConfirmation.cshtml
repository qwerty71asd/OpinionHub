@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Проверьте почту";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2">
        <i class="bi bi-envelope-arrow-up"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">
        Если такой email зарегистрирован — мы отправили ссылку для сброса пароля.
    </p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4 text-center">
            <div class="mb-3"><i class="bi bi-envelope-arrow-up display-4 text-primary"></i></div>
            <p class="text-secondary small mb-4">
                Перейдите по ссылке из письма, чтобы задать новый пароль.
            </p>
            <a asp-page="./Login" class="btn btn-outline-secondary btn-lg w-100">
                <i class="bi bi-arrow-left me-1"></i>Вернуться на вход
            </a>
        </div>
    </div>
</div>
