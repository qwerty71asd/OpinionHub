@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Аккаунт заблокирован";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2 text-danger">
        <i class="bi bi-lock"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">Вход в систему временно недоступен.</p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4 text-center">
            <div class="mb-3"><i class="bi bi-lock display-4 text-danger"></i></div>

            @if (!string.IsNullOrWhiteSpace(Model.LockoutLogin))
            {
                <div class="mb-2"><span class="text-secondary">Пользователь:</span> <strong>@Model.LockoutLogin</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LockoutUntilText))
            {
                <div class="mb-2"><span class="text-secondary">Срок блокировки:</span> <strong>@Model.LockoutUntilText</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BannedAtLocalText))
            {
                <div class="mb-2"><span class="text-secondary">Заблокирован:</span> <strong>@Model.BannedAtLocalText</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.BanReason))
            {
                <div class="mb-3 text-start">
                    <div class="text-secondary mb-1">Причина:</div>
                    <div class="border rounded p-2 bg-light"><strong>@Model.BanReason</strong></div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.AppealMessage))
            {
                <div class="alert alert-success small mb-3">@Model.AppealMessage</div>
            }

            <p class="text-secondary small mb-3">
                Если вы считаете, что это ошибка — подайте апелляцию администраторам.
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.AppealForUserName))
            {
                if (Model.HasPendingAppeal)
                {
                    <div class="alert alert-info small mb-3">
                        <i class="bi bi-megaphone me-1"></i>Апелляция уже отправлена, ожидайте решения.
                    </div>
                }
                else
                {
                    <a asp-controller="Appeals" asp-action="Create" asp-route-userName="@Model.AppealForUserName"
                       asp-area=""
                       class="btn btn-warning btn-lg w-100 mb-2">
                        <i class="bi bi-megaphone me-1"></i>Подать апелляцию
                    </a>
                }
            }

            <a href="/" class="btn btn-primary btn-lg w-100 mb-2">
                <i class="bi bi-house me-1"></i>На главную
            </a>
            <a asp-page="./Login" class="btn btn-outline-secondary btn-lg w-100">
                <i class="bi bi-arrow-left me-1"></i>Вернуться на вход
            </a>
        </div>
    </div>
</div>
