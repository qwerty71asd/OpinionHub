@page
@model OpinionHub.Web.Areas.Identity.Pages.Account.LockoutModel
@{
    ViewData["Title"] = "Аккаунт заблокирован";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title justify-content-center text-center mb-2 text-danger">
        <i class="bi bi-lock"></i>@ViewData["Title"]
    </h1>
    <p class="oh-page-subtitle text-center mb-3">Вход в систему временно недоступен.</p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4 text-center">
            <div class="mb-3"><i class="bi bi-lock display-4 text-danger"></i></div>

            @if (!string.IsNullOrWhiteSpace(Model.LockoutLogin))
            {
                <div class="mb-2"><span class="text-secondary">Пользователь:</span> <strong>@Model.LockoutLogin</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.LockoutUntilText))
            {
                <div class="mb-3"><span class="text-secondary">Срок блокировки:</span> <strong>@Model.LockoutUntilText</strong></div>
            }

            <p class="text-secondary small mb-4">
                Если вы считаете, что это ошибка — обратитесь к администратору.
            </p>

            <a asp-page="./Login" class="btn btn-outline-secondary btn-lg w-100">
                <i class="bi bi-arrow-left me-1"></i>Вернуться на вход
            </a>
        </div>
    </div>
</div>
