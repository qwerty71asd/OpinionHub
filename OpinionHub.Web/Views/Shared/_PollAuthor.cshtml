@model OpinionHub.Web.ViewModels.PollAuthorLinkViewModel
@if (Model.IsAnonymous || string.IsNullOrEmpty(Model.UserName))
{
    <span class="text-secondary">Аноним</span>
}
else if (Model.IsDeleted)
{
    <span class="d-inline-flex align-items-center gap-1 text-secondary fst-italic" title="Аккаунт удалён">
        <span class="rounded-circle bg-secondary-subtle text-secondary d-inline-flex align-items-center justify-content-center"
              style="width:24px;height:24px;">
            <i class="bi bi-person-x"></i>
        </span>
        Удалённый аккаунт
    </span>
}
else
{
    <span class="d-inline-flex align-items-center gap-1">
        @await Html.PartialAsync("_UserAvatar",
            new OpinionHub.Web.ViewModels.UserAvatarViewModel(Model.UserName, Model.AvatarPath, 24))
        <a asp-controller="Profile" asp-action="Index" asp-route-userName="@Model.UserName"
           class="text-decoration-none fw-semibold">@Model.UserName</a>
    </span>
}
