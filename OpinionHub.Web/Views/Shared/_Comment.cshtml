@model OpinionHub.Web.ViewModels.CommentNodeViewModel
@functions {
    static string Pluralize(int n)
    {
        var mod10 = n % 10;
        var mod100 = n % 100;
        if (mod10 == 1 && mod100 != 11) return "ответ";
        if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return "ответа";
        return "ответов";
    }
}
@{
    var initial = string.IsNullOrEmpty(Model.AuthorUserName) ? "?" : Model.AuthorUserName[0].ToString().ToUpper();
    var repliesCount = Model.Replies?.Count ?? 0;
    var displayName = Model.IsAuthorDeleted ? "Удалённый аккаунт" : Model.AuthorUserName;
}

<div class="comment-node mb-3"
     data-comment-id="@Model.Id"
     data-author-id="@Model.AuthorId"
     data-author-username="@Model.AuthorUserName"
     data-display-name="@displayName"
     data-is-deleted="@(Model.IsDeleted ? "true" : "false")"
     data-is-author-deleted="@(Model.IsAuthorDeleted ? "true" : "false")">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <div class="d-flex gap-3">
                <div class="flex-shrink-0">
                    @if (Model.IsAuthorDeleted)
                    {
                        <div class="rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center"
                             style="width:36px;height:36px;" title="Удалённый аккаунт">
                            <i class="bi bi-person-x"></i>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold"
                             style="width:36px;height:36px;">
                            @initial
                        </div>
                    }
                </div>
                <div class="flex-grow-1" style="min-width:0;">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        @if (Model.IsAuthorDeleted)
                        {
                            <span class="fw-semibold text-secondary fst-italic">@displayName</span>
                        }
                        else
                        {
                            <a asp-controller="Profile" asp-action="Index" asp-route-userName="@Model.AuthorUserName" class="fw-semibold text-decoration-none">
                                @displayName
                            </a>
                        }
                        @if (Model.IsByPollAuthor && !Model.IsAuthorDeleted)
                        {
                            <span class="badge rounded-pill bg-primary-subtle text-primary" title="Автор опроса">Автор</span>
                        }
                        <span class="text-secondary small">@Model.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    </div>

                    <div class="mb-2" style="white-space:pre-wrap; word-break:break-word;">@Model.Text</div>

                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImagePath"
                                 alt="Изображение"
                                 class="rounded border comment-image"
                                 role="button"
                                 tabindex="0"
                                 style="max-width:240px; max-height:240px; cursor:zoom-in;" />
                        </div>
                    }

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="button"
                                class="btn btn-sm @(Model.IsLikedByMe ? "btn-danger" : "btn-outline-danger") comment-like-btn d-inline-flex align-items-center gap-1"
                                data-comment-id="@Model.Id"
                                data-liked="@(Model.IsLikedByMe ? "true" : "false")"
                                aria-pressed="@(Model.IsLikedByMe ? "true" : "false")">
                            <i class="bi @(Model.IsLikedByMe ? "bi-heart-fill" : "bi-heart")"></i>
                            <span class="comment-like-count">@Model.LikeCount</span>
                        </button>

                        @if (Model.IsLikedByPollAuthor)
                        {
                            <span class="badge rounded-pill bg-warning-subtle text-warning" title="Лайк от автора опроса">
                                <i class="bi bi-star-fill me-1"></i>Лайк от автора
                            </span>
                        }

                        <div class="comment-actions-slot d-inline-flex flex-wrap align-items-center gap-2"></div>
                    </div>

                    <div class="comment-reply-form-wrap mt-2 d-none" id="reply-form-@Model.Id">
                        <form class="comment-reply-form oh-composer is-compact" data-parent-id="@Model.Id">
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="oh-composer-pill">
                                    <textarea class="oh-composer-input"
                                              name="text"
                                              rows="1"
                                              maxlength="2000"
                                              placeholder="Ответ..."></textarea>
                                    <input type="file"
                                           class="oh-composer-file d-none"
                                           accept="image/jpeg,image/png,image/webp,image/gif" />
                                    <button type="button"
                                            class="oh-composer-icon-btn oh-composer-attach"
                                            title="Прикрепить фото (только одно)"
                                            aria-label="Прикрепить фото">
                                        <i class="bi bi-paperclip"></i>
                                    </button>
                                    <button type="submit"
                                            class="btn btn-primary oh-composer-send"
                                            title="Отправить"
                                            aria-label="Отправить">
                                        <i class="bi bi-send-fill"></i>
                                    </button>
                                </div>
                                <div class="oh-composer-preview d-none">
                                    <img alt="Превью" />
                                    <div class="meta">
                                        <span class="filename"></span>
                                        <span class="hint">Только одно фото · до 5 МБ</span>
                                    </div>
                                    <button type="button" class="remove-btn" title="Убрать" aria-label="Убрать вложение">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* TikTok-flat секция ответов. Контейнер существует всегда — даже если ответов нет:
       первый ответ JS добавит сюда, а потом будет инкрементить total на кнопках.
       Кнопки идут СНИЗУ списка: после раскрытия батча они смещаются вниз вместе
       с ним, и пользователь продолжает читать линейно. *@
    <div class="comment-replies" data-root-id="@Model.Id" data-batch="3">
        <div class="replies-list">
            @if (Model.Replies is { Count: > 0 })
            {
                foreach (var reply in Model.Replies)
                {
                    @await Html.PartialAsync("_CommentReply", reply)
                }
            }
        </div>
        <div class="comment-replies-actions">
            <button type="button"
                    class="btn btn-sm btn-link comment-replies-toggle @(repliesCount == 0 ? "d-none" : "")"
                    data-shown="0"
                    data-total="@repliesCount">
                <i class="bi bi-chevron-down me-1"></i>
                <span class="label">Показать @repliesCount @Pluralize(repliesCount)</span>
            </button>
            <button type="button"
                    class="btn btn-sm btn-link comment-replies-collapse d-none">
                <i class="bi bi-chevron-up me-1"></i>Скрыть
            </button>
        </div>
    </div>
</div>
