@using System.Security.Claims
@using System.Text.Json
<!DOCTYPE html>
<html lang="ru" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpinionHub</title>

    <script>
        // Темная/светлая тема без мигалки (ставим до CSS)
        (function () {
            try {
                const saved = localStorage.getItem('oh-theme');
                const theme = saved || (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch { }
        })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="oh-body">

<nav class="navbar navbar-expand navbar-blur sticky-top py-2">
    <div class="container d-flex align-items-center gap-2 flex-nowrap">
        <a class="navbar-brand fw-semibold d-flex align-items-center gap-2 me-1 me-sm-3"
           asp-controller="Home" asp-action="Index">
            <span class="brand-dot"></span>
            <span class="d-none d-sm-inline">OpinionHub</span>
        </a>

        <ul class="navbar-nav flex-row me-auto gap-1 gap-sm-2 mb-0">
            <li class="nav-item">
                <a class="nav-link oh-nav-link" asp-controller="Home" asp-action="Index"
                   title="Лента" aria-label="Лента">
                    <i class="bi bi-collection"></i>
                    <span class="d-none d-sm-inline ms-1">Лента</span>
                </a>
            </li>
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link oh-nav-link" asp-controller="Admin" asp-action="Index"
                       title="Админка" aria-label="Админка">
                        <i class="bi bi-shield-lock"></i>
                        <span class="d-none d-sm-inline ms-1">Админка</span>
                        @await Component.InvokeAsync("AdminCounters")
                    </a>
                </li>
            }
        </ul>

        <div class="d-flex align-items-center gap-1 gap-sm-2 flex-nowrap">
            <button class="btn btn-outline-secondary btn-sm oh-icon-btn"
                    type="button" id="themeToggle"
                    title="Сменить тему" aria-label="Сменить тему">
                <i class="bi bi-moon-stars"></i>
            </button>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Polls" asp-action="Create"
                   class="btn btn-primary btn-sm"
                   title="Создать опрос" aria-label="Создать опрос">
                    <i class="bi bi-plus-lg"></i>
                    <span class="d-none d-sm-inline ms-1">Создать</span>
                </a>

                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false"
                            title="Аккаунт" aria-label="Аккаунт">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-sm-inline ms-1">@(User.Identity?.Name ?? "Аккаунт")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-area="" asp-controller="Polls" asp-action="Profile">
                                <i class="bi bi-person me-2"></i>Мои опросы
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-area="" asp-controller="Telegram" asp-action="Link">
                                <i class="bi bi-telegram me-2"></i>Telegram
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                <i class="bi bi-gear me-2"></i>Настройки аккаунта
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="px-3">
                                <button class="btn btn-danger btn-sm w-100" type="submit">
                                    <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="btn btn-outline-secondary btn-sm"
                   title="Войти" aria-label="Войти">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span class="d-none d-sm-inline ms-1">Войти</span>
                </a>
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="btn btn-primary btn-sm"
                   title="Регистрация" aria-label="Регистрация">
                    <i class="bi bi-person-plus"></i>
                    <span class="d-none d-sm-inline ms-1">Регистрация</span>
                </a>
            }
        </div>
    </div>
</nav>

<main>
    @RenderBody()
</main>

<footer class="footer mt-auto py-4">
    <div class="container small text-secondary d-flex flex-column flex-md-row justify-content-between gap-2">
        <div>© @DateTime.Now.Year OpinionHub</div>
        <div class="d-flex gap-3">
            <span class="text-secondary">ASP.NET Core • EF Core • PostgreSQL</span>
        </div>
    </div>
</footer>

@{
    var ohPayload = JsonSerializer.Serialize(new
    {
        currentUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value,
        userName = User.Identity?.Name,
        isAuthenticated = User.Identity?.IsAuthenticated == true,
        isAdmin = User.IsInRole("Admin")
    });
}
<script>window.OH = @Html.Raw(ohPayload);</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
