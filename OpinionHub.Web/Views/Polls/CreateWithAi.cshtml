@model OpinionHub.Web.ViewModels.CreateWithAiInputVm
@{
    ViewData["Title"] = "Опрос за один промпт";
}

<div class="container oh-page oh-page--narrow">
    <h1 class="h3 oh-page-title text-center mb-2">
        <i class="bi bi-stars"></i>Опрос за один промпт
    </h1>
    <p class="oh-page-subtitle text-center mb-3">
        Опиши тему — Gemini сгенерирует заголовок, описание и варианты ответа.
        Дальше отредактируешь и опубликуешь.
    </p>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4">
            <form method="post" novalidate>
                @Html.AntiForgeryToken()

                @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelErrors) && modelErrors.Errors.Any())
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <div class="mb-3">
                    <label asp-for="Topic" class="form-label fw-bold">Тема опроса</label>
                    <textarea asp-for="Topic" class="form-control" rows="3" maxlength="200"
                              placeholder="Например: какой язык программирования выбрать для первого проекта"></textarea>
                    <span asp-validation-for="Topic" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OptionCount" class="form-label fw-bold">Число вариантов</label>
                    <select asp-for="OptionCount" class="form-select">
                        @for (int i = 2; i <= 6; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">
                    <i class="bi bi-stars me-1"></i>Сгенерировать и открыть в редакторе
                </button>

                <div class="mt-3 text-center small text-secondary">
                    Или <a asp-action="Create">создай опрос вручную</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
