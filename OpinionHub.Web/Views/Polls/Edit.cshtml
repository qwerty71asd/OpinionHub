@model OpinionHub.Web.ViewModels.EditPollViewModel
@{
    ViewData["Title"] = "Редактирование черновика";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

<div class="container oh-page oh-page--wide">
    <div class="oh-page-header">
        <div>
            <h1 class="h3 oh-page-title">
                <i class="bi bi-pencil-square"></i>Редактирование черновика
            </h1>
            <p class="oh-page-subtitle mb-0">Доправь черновик и опубликуй, когда будешь готов.</p>
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-controller="Polls" asp-action="Details" asp-route-id="@Model.Id">
            <i class="bi bi-arrow-left me-1"></i>К черновику
        </a>
    </div>

    <div class="card border-0 shadow-sm oh-card">
        <div class="card-body p-4 p-md-4">

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingCoverPath" />

                @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelErrors) && modelErrors.Errors.Any())
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <h6 class="oh-section-title"><i class="bi bi-pencil"></i>Основное</h6>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Название</label>
                    <input asp-for="Title" class="form-control form-control-lg" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Описание</label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              maxlength="1000"
                              placeholder="Расскажите подробнее: контекст, правила, как выбирать..."></textarea>
                    <div class="form-text">Необязательно. До 1000 символов, переносы строк сохранятся.</div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3 p-3 border rounded-3 bg-body-tertiary">
                    <label class="form-label fw-bold mb-1">Заглавное фото (обложка)</label>
                    <div class="form-text mb-2">Фото будет отображаться в ленте (формат 16:9).</div>

                    @if (!string.IsNullOrEmpty(Model.ExistingCoverPath))
                    {
                        <div id="existingCoverBlock" class="mb-2">
                            <img src="@Model.ExistingCoverPath" class="img-fluid rounded border shadow-sm mb-2" style="max-height: 220px; object-fit: cover; width: 100%;" />
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="RemoveCover" id="removeCoverCheck" />
                                <label class="form-check-label" for="removeCoverCheck">Удалить текущую обложку</label>
                            </div>
                        </div>
                    }

                    <label for="coverInput" id="coverInputLabel" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center text-truncate border-2 border-dashed m-0" style="cursor: pointer; min-height: 52px;">
                        <i class="bi bi-image me-2 fs-5"></i> <span id="coverInputText" class="fw-medium">@(string.IsNullOrEmpty(Model.ExistingCoverPath) ? "Выбрать файл обложки..." : "Заменить обложку...")</span>
                    </label>
                    <input type="file" asp-for="CoverImage" class="d-none" id="coverInput" accept="image/*" />

                    <div id="coverPreviewContainer" class="mt-3 d-none">
                        <img id="coverPreview" class="img-fluid rounded border shadow-sm mb-2" style="max-height: 220px; object-fit: cover; width: 100%;" />
                        <div id="aspectRatioWarning" class="alert alert-warning d-none mb-0">
                            <i class="bi bi-exclamation-triangle"></i> Соотношение сторон этого фото отличается от 16:9.
                        </div>
                    </div>
                </div>

                <h6 class="oh-section-title"><i class="bi bi-sliders"></i>Тип и доступ</h6>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="PollType" class="form-label fw-bold">Тип голосования</label>
                        <select asp-for="PollType" class="form-select" id="pollTypeSelect">
                            <option value="SingleChoice">Один вариант</option>
                            <option value="MultipleChoice">Несколько вариантов</option>
                        </select>
                        <div class="form-text text-primary mt-1" id="pollTypeHint" style="min-height: 32px;"></div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VisibilityType" class="form-label fw-bold">Видимость голосов</label>
                        <select asp-for="VisibilityType" class="form-select" id="visibilitySelect">
                            <option value="Public">Открытое голосование</option>
                            <option value="Anonymous">Анонимное голосование</option>
                        </select>
                        <div class="form-text text-primary mt-1" id="visibilityHint" style="min-height: 32px;"></div>
                    </div>
                </div>

                <div class="mt-2">
                    <label asp-for="AudienceType" class="form-label fw-bold">Доступ к опросу</label>
                    <select asp-for="AudienceType" class="form-select" id="audienceSelect">
                        <option value="Everyone">Все пользователи</option>
                        <option value="SelectedUsers">Только выбранные пользователи</option>
                    </select>
                    <div class="form-text text-primary mt-1" id="audienceHint"></div>
                </div>

                <div id="audienceUsersBox" class="mt-3 border rounded-3 p-3 d-none position-relative">
                    <label class="form-label fw-bold">Пригласить участников</label>
                    <input type="text" class="form-control" id="userSearch" placeholder="Начни вводить логин…" autocomplete="off" />
                    <div class="list-group mt-2 shadow-sm position-absolute z-3 w-100" id="userResults" style="max-height: 220px; overflow:auto; max-width: 90%;"></div>

                    <div id="selectedUsers" class="mt-3 d-flex flex-wrap gap-2">
                        @foreach (var uid in Model.AllowedUserIds)
                        {
                            <span class="badge rounded-pill text-bg-primary d-inline-flex align-items-center gap-2 me-1 mb-1" data-user-id="@uid">
                                @uid
                                <button type="button" class="btn-close btn-close-white btn-sm" aria-label="Удалить"></button>
                                <input type="hidden" name="AllowedUserIds" value="@uid" />
                            </span>
                        }
                    </div>
                    <div id="audienceValidation" class="text-danger small mt-2 d-none">Добавь хотя бы одного пользователя.</div>
                </div>

                <h6 class="oh-section-title"><i class="bi bi-clock"></i>Срок и поведение</h6>

                <div class="row g-3 align-items-start">
                    <div class="col-md-7">
                        <label class="form-label fw-bold">Срок проведения</label>
                        <select class="form-select" id="quickDateSelect">
                            <option value="tomorrow">До завтра</option>
                            <option value="week">1 неделя</option>
                            <option value="month">1 месяц (максимум)</option>
                            <option value="custom" selected>Указать точную дату и время...</option>
                        </select>

                        <div id="customDateContainer" class="mt-2">
                            <input asp-for="EndDateUtc" class="form-control border-primary" type="datetime-local" id="customDateInput" />
                            <div class="form-text text-danger d-none" id="dateError">Дата не может быть больше, чем через месяц!</div>
                        </div>

                        <div class="form-text mt-1" id="dateHint"></div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-check form-switch fs-6 mt-md-4 pt-md-1">
                            <input class="form-check-input" type="checkbox" asp-for="CanChangeVote" id="canChangeVoteSwitch">
                            <label class="form-check-label ms-1" for="canChangeVoteSwitch">Разрешить менять голос</label>
                        </div>
                        <div class="form-text text-secondary">Пользователи смогут переголосовать до окончания.</div>

                        <div class="form-check form-switch fs-6 mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsAnonymousAuthor" id="isAnonymousAuthorSwitch">
                            <label class="form-check-label ms-1" for="isAnonymousAuthorSwitch">Опубликовать анонимно</label>
                        </div>
                        <div class="form-text text-secondary">В ленте и на странице опроса будет «Аноним».</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                    <h6 class="oh-section-title mb-0"><i class="bi bi-list-ol"></i>Варианты ответа</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="addOptionBtn">
                        <i class="bi bi-plus-lg me-1"></i>Добавить
                    </button>
                </div>

                <div id="optionsList" class="vstack gap-2">
                    @for (var i = 0; i < Model.Options.Count; i++)
                    {
                        var opt = Model.Options[i];
                        <div class="border rounded shadow-sm p-2 mb-2 option-row">
                            <div class="input-group align-items-stretch">
                                <span class="input-group-text bg-body-tertiary fw-bold text-secondary border-end-0">@(i + 1)</span>
                                @if (opt.Id.HasValue)
                                {
                                    <input type="hidden" name="Options[@i].Id" value="@opt.Id" />
                                }
                                <input name="Options[@i].Text" class="form-control border-start-0 border-end-0 ps-0" value="@opt.Text" placeholder="Текст варианта..." required />

                                <label for="optionImage_@i" class="input-group-text text-secondary border-start-0 mb-0 px-3 d-flex align-items-center justify-content-center option-image-label" style="cursor: pointer; width: 54px; overflow: hidden; padding: 0 !important;" title="Прикрепить фото">
                                    <i class="bi bi-paperclip fs-5 option-icon"></i>
                                    <img class="option-preview d-none" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" />
                                </label>
                                <input type="file" name="Options[@i].Image" id="optionImage_@i" class="d-none option-image-input" accept="image/*" />

                                <button type="button" class="btn btn-outline-danger remove-option px-3" title="Удалить"><i class="bi bi-trash"></i></button>
                            </div>

                            @if (!string.IsNullOrEmpty(opt.ExistingImagePath))
                            {
                                <div class="mt-2 d-flex align-items-center gap-2">
                                    <img src="@opt.ExistingImagePath" style="width:48px;height:48px;object-fit:cover;border-radius:4px;" />
                                    <input type="hidden" name="Options[@i].ExistingImagePath" value="@opt.ExistingImagePath" />
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="Options[@i].RemoveImage" value="true" id="removeImg_@i" />
                                        <label class="form-check-label small" for="removeImg_@i">Удалить картинку варианта</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <h6 class="oh-section-title mt-4"><i class="bi bi-paperclip"></i>Дополнительные файлы</h6>

                @if (Model.ExistingAttachments.Any())
                {
                    <div class="mb-3">
                        <div class="form-text mb-2">Уже прикреплены:</div>
                        <ul class="list-group">
                            @foreach (var att in Model.ExistingAttachments)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <a href="@att.FilePath" target="_blank" class="text-decoration-none">
                                        <i class="bi bi-paperclip me-1"></i>@att.OriginalFileName
                                    </a>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="RemoveAttachmentIds" value="@att.Id" id="removeAtt_@att.Id" />
                                        <label class="form-check-label small text-danger" for="removeAtt_@att.Id">Удалить</label>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Добавить новые файлы</label>
                    <input type="file" asp-for="AttachedFiles" class="form-control" multiple id="attachmentInput" />
                    <div class="form-text">Документы, схемы или референсы. Будут доступны для скачивания внутри опроса.</div>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-end gap-2 mt-4">
                    <button type="submit" class="btn btn-outline-secondary" name="PublishNow" value="false">
                        <i class="bi bi-archive me-1"></i>Сохранить черновик
                    </button>
                    <button type="submit" class="btn btn-primary fw-semibold" name="PublishNow" value="true">
                        <i class="bi bi-send me-1"></i>Опубликовать сейчас
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="cropModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-body text-body">
            <div class="modal-header border-bottom border-secondary">
                <h5 class="modal-title fw-bold">Кадрирование обложки</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body text-center bg-body-tertiary">
                <div class="img-container" style="max-height: 60vh; overflow: hidden;">
                    <img id="imageToCrop" src="" style="max-width: 100%; display: block;">
                </div>
            </div>
            <div class="modal-footer border-top border-secondary">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" id="cropBtn">Применить</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <script>
        // --- ХИНТЫ для select'ов (те же, что в Create) ---
        (function () {
            const hints = {
                pollType: {
                    'SingleChoice': '<i class="bi bi-info-circle text-primary"></i> Участники смогут выбрать строго <b>один</b> вариант ответа.',
                    'MultipleChoice': '<i class="bi bi-info-circle text-primary"></i> Участники смогут выбрать <b>несколько</b> вариантов одновременно.'
                },
                visibility: {
                    'Public': '<i class="bi bi-eye text-primary"></i> Все будут видеть, кто именно и за какой вариант проголосовал.',
                    'Anonymous': '<i class="bi bi-incognito text-primary"></i> Голоса учтутся, но никто (даже вы) не узнает авторов голосов.'
                },
                audience: {
                    'Everyone': '<i class="bi bi-globe text-primary"></i> Опрос будет виден в общей ленте. Голосовать смогут все.',
                    'SelectedUsers': '<i class="bi bi-lock text-primary"></i> Опрос скрыт из ленты. Доступ только по приглашениям.'
                }
            };
            function updateHint(selectId, hintId, dict) {
                const sel = document.getElementById(selectId);
                const hint = document.getElementById(hintId);
                if (!sel || !hint) return;
                const apply = () => { hint.innerHTML = dict[sel.value] || ''; };
                sel.addEventListener('change', apply);
                apply();
            }
            updateHint('pollTypeSelect', 'pollTypeHint', hints.pollType);
            updateHint('visibilitySelect', 'visibilityHint', hints.visibility);
            updateHint('audienceSelect', 'audienceHint', hints.audience);
        })();

        // --- УМНАЯ ДАТА (упрощенная: уже стоит custom) ---
        (function () {
            const quickDate = document.getElementById('quickDateSelect');
            const customDateContainer = document.getElementById('customDateContainer');
            const customDateInput = document.getElementById('customDateInput');
            const dateError = document.getElementById('dateError');
            function pad(n) { return n.toString().padStart(2, '0'); }
            function formatForInput(d) { return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`; }
            const now = new Date();
            const maxDate = new Date(); maxDate.setMonth(maxDate.getMonth() + 1);
            customDateInput.min = formatForInput(now);
            customDateInput.max = formatForInput(maxDate);

            quickDate.addEventListener('change', function () {
                const t = new Date();
                if (this.value === 'tomorrow') { t.setDate(t.getDate() + 1); customDateInput.value = formatForInput(t); }
                else if (this.value === 'week') { t.setDate(t.getDate() + 7); customDateInput.value = formatForInput(t); }
                else if (this.value === 'month') { customDateInput.value = formatForInput(maxDate); }
            });
        })();

        // --- ВАРИАНТЫ ОТВЕТА ---
        (function () {
            const list = document.getElementById('optionsList');
            const addBtn = document.getElementById('addOptionBtn');

            function renumber() {
                const rows = list.querySelectorAll('.option-row');
                rows.forEach((row, idx) => {
                    const badge = row.querySelector('.input-group-text');
                    if (badge) badge.textContent = String(idx + 1);
                    row.querySelectorAll('input,label').forEach(el => {
                        if (el.name) el.name = el.name.replace(/Options\[\d+\]/, `Options[${idx}]`);
                        if (el.id && el.id.startsWith('optionImage_')) el.id = `optionImage_${idx}`;
                        if (el.id && el.id.startsWith('removeImg_')) el.id = `removeImg_${idx}`;
                        if (el.getAttribute && el.getAttribute('for') && el.getAttribute('for').startsWith('optionImage_')) {
                            el.setAttribute('for', `optionImage_${idx}`);
                        }
                        if (el.getAttribute && el.getAttribute('for') && el.getAttribute('for').startsWith('removeImg_')) {
                            el.setAttribute('for', `removeImg_${idx}`);
                        }
                    });
                });
            }

            list.addEventListener('click', (e) => {
                const btn = e.target.closest('.remove-option');
                if (!btn) return;
                const row = btn.closest('.option-row');
                if (!row) return;
                row.remove();
                if (list.querySelectorAll('.option-row').length < 2) addOption();
                renumber();
            });

            list.addEventListener('change', (e) => {
                if (e.target.classList.contains('option-image-input')) {
                    const label = e.target.previousElementSibling;
                    const icon = label.querySelector('.option-icon');
                    const preview = label.querySelector('.option-preview');
                    const file = e.target.files[0];
                    if (file) {
                        preview.src = URL.createObjectURL(file);
                        preview.classList.remove('d-none');
                        icon.classList.add('d-none');
                    } else {
                        preview.src = '';
                        preview.classList.add('d-none');
                        icon.classList.remove('d-none');
                    }
                }
            });

            function addOption() {
                const idx = list.querySelectorAll('.option-row').length;
                const wrap = document.createElement('div');
                wrap.className = 'border rounded shadow-sm p-2 mb-2 option-row';
                wrap.innerHTML = `
                    <div class="input-group align-items-stretch">
                        <span class="input-group-text bg-body-tertiary fw-bold text-secondary border-end-0">${idx + 1}</span>
                        <input name="Options[${idx}].Text" class="form-control border-start-0 border-end-0 ps-0" placeholder="Текст варианта..." required />
                        <label for="optionImage_${idx}" class="input-group-text text-secondary border-start-0 mb-0 px-3 d-flex align-items-center justify-content-center option-image-label" style="cursor: pointer; width: 54px; overflow: hidden; padding: 0 !important;" title="Прикрепить фото">
                            <i class="bi bi-paperclip fs-5 option-icon"></i>
                            <img class="option-preview d-none" style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" />
                        </label>
                        <input type="file" name="Options[${idx}].Image" id="optionImage_${idx}" class="d-none option-image-input" accept="image/*" />
                        <button type="button" class="btn btn-outline-danger remove-option px-3" title="Удалить"><i class="bi bi-trash"></i></button>
                    </div>`;
                list.appendChild(wrap);
            }

            addBtn.addEventListener('click', () => { addOption(); renumber(); });
        })();

        // --- CROPPER ДЛЯ ОБЛОЖКИ ---
        (function () {
            const coverInput = document.getElementById('coverInput');
            const coverInputText = document.getElementById('coverInputText');
            const previewContainer = document.getElementById('coverPreviewContainer');
            const previewImage = document.getElementById('coverPreview');
            let cropper;
            const cropModalElement = document.getElementById('cropModal');
            const cropModal = new bootstrap.Modal(cropModalElement);
            const imageToCrop = document.getElementById('imageToCrop');
            let currentFileName = "cover.jpg";

            coverInput.addEventListener('change', function (e) {
                const files = e.target.files;
                if (files && files.length > 0) {
                    const file = files[0];
                    currentFileName = file.name;
                    imageToCrop.src = URL.createObjectURL(file);
                    cropModal.show();
                } else {
                    previewContainer.classList.add('d-none');
                }
            });

            cropModalElement.addEventListener('shown.bs.modal', function () {
                cropper = new Cropper(imageToCrop, { aspectRatio: 16 / 9, viewMode: 2, autoCropArea: 1 });
            });

            cropModalElement.addEventListener('hidden.bs.modal', function () {
                if (cropper) { cropper.destroy(); cropper = null; }
                if (previewContainer.classList.contains('d-none')) coverInput.value = '';
            });

            document.getElementById('cropBtn').addEventListener('click', function () {
                if (!cropper) return;
                const canvas = cropper.getCroppedCanvas({ width: 1280, height: 720, imageSmoothingEnabled: true, imageSmoothingQuality: 'high' });
                canvas.toBlob(function (blob) {
                    const croppedFile = new File([blob], currentFileName, { type: 'image/jpeg', lastModified: Date.now() });
                    const dt = new DataTransfer();
                    dt.items.add(croppedFile);
                    coverInput.files = dt.files;
                    previewImage.src = URL.createObjectURL(croppedFile);
                    previewContainer.classList.remove('d-none');
                    coverInputText.textContent = currentFileName + " (Обрезано 16:9)";
                    cropModal.hide();
                }, 'image/jpeg', 0.9);
            });
        })();

        // --- ПОИСК ПОЛЬЗОВАТЕЛЕЙ ---
        (function () {
            const audienceSelect = document.getElementById('audienceSelect');
            const box = document.getElementById('audienceUsersBox');
            const search = document.getElementById('userSearch');
            const results = document.getElementById('userResults');
            const selected = document.getElementById('selectedUsers');
            const validation = document.getElementById('audienceValidation');
            const selectedIds = new Set();
            // существующие chip'ы при загрузке
            selected.querySelectorAll('[data-user-id]').forEach(chip => {
                selectedIds.add(chip.getAttribute('data-user-id'));
                chip.querySelector('button')?.addEventListener('click', () => {
                    selectedIds.delete(chip.getAttribute('data-user-id'));
                    chip.remove();
                });
            });
            function setBoxVisibility() {
                const isSel = audienceSelect.value === 'SelectedUsers';
                box.classList.toggle('d-none', !isSel);
                if (!isSel) validation.classList.add('d-none');
            }
            function escapeHtml(s) { return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;'); }
            function clearResults() { results.innerHTML = ''; }
            function renderResults(items) {
                clearResults();
                if (!items || !items.length) return;
                for (const u of items) {
                    const a = document.createElement('button');
                    a.type = 'button';
                    a.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-body text-body';
                    a.innerHTML = `<span>${escapeHtml(u.userName)}</span><span class="badge text-bg-secondary">добавить</span>`;
                    a.addEventListener('click', () => addUser(u.id, u.userName));
                    results.appendChild(a);
                }
            }
            function addUser(id, userName) {
                if (selectedIds.has(id)) return;
                selectedIds.add(id);
                const chip = document.createElement('span');
                chip.className = 'badge rounded-pill text-bg-primary d-inline-flex align-items-center gap-2 me-1 mb-1';
                chip.dataset.userId = id;
                chip.innerHTML = `${escapeHtml(userName)} <button type="button" class="btn-close btn-close-white btn-sm"></button>`;
                const hidden = document.createElement('input');
                hidden.type = 'hidden';
                hidden.name = 'AllowedUserIds';
                hidden.value = id;
                chip.appendChild(hidden);
                chip.querySelector('button')?.addEventListener('click', () => { selectedIds.delete(id); chip.remove(); });
                selected.appendChild(chip);
                validation.classList.add('d-none');
                clearResults();
                search.value = '';
                search.focus();
            }
            let abort = null, t = null;
            search?.addEventListener('input', () => {
                const q = (search.value || '').trim();
                if (t) clearTimeout(t);
                t = setTimeout(async () => {
                    if (q.length < 2) { clearResults(); return; }
                    try {
                        abort?.abort();
                        abort = new AbortController();
                        const resp = await fetch(`/api/users/search?q=${encodeURIComponent(q)}`, { signal: abort.signal });
                        if (!resp.ok) return;
                        const data = await resp.json();
                        renderResults((data || []).filter(x => !selectedIds.has(x.id)));
                    } catch { }
                }, 200);
            });
            document.querySelector('form')?.addEventListener('submit', (e) => {
                if (audienceSelect.value === 'SelectedUsers' && selectedIds.size === 0) {
                    validation.classList.remove('d-none');
                    e.preventDefault();
                    search.focus();
                }
            });
            audienceSelect?.addEventListener('change', setBoxVisibility);
            setBoxVisibility();
        })();

        // --- SUBMIT GUARD + сохранение PublishNow ---
        (function () {
            const form = document.querySelector('form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                if (e.defaultPrevented) return;
                const submitter = e.submitter;
                if (submitter && submitter.name === 'PublishNow') {
                    let hidden = form.querySelector('input[type="hidden"][name="PublishNow"]');
                    if (!hidden) {
                        hidden = document.createElement('input');
                        hidden.type = 'hidden';
                        hidden.name = 'PublishNow';
                        form.appendChild(hidden);
                    }
                    hidden.value = submitter.value;
                }
                form.querySelectorAll('button[type="submit"]').forEach(b => b.disabled = true);
            });
        })();
    </script>
}
