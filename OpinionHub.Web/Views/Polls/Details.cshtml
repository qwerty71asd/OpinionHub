@using System.Security.Claims
@using OpinionHub.Web.Models
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@model OpinionHub.Web.Models.Poll
@{
    ViewData["Title"] = Model.Title;
    var total = Model.Votes.Count;
    var myId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    var isAuthor = User.Identity?.IsAuthenticated == true && myId == Model.AuthorId;
    var isEmailConfirmed = (ViewBag.IsEmailConfirmed as bool?) ?? false;
    var returnUrl = Url.Action("Details", "Polls", new { id = Model.Id });
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var likeCount = (ViewBag.LikeCount as int?) ?? 0;
    var isLiked = (ViewBag.IsLiked as bool?) ?? false;
    var canLike = User.Identity?.IsAuthenticated == true;
    var afTokens = Antiforgery.GetAndStoreTokens(Context);
    var comments = (ViewBag.Comments as IReadOnlyList<OpinionHub.Web.ViewModels.CommentNodeViewModel>) ?? Array.Empty<OpinionHub.Web.ViewModels.CommentNodeViewModel>();
    var totalCommentsCount = CountCommentsRecursively(comments);
    var hasCover = !string.IsNullOrEmpty(Model.CoverImagePath);
}

@functions {
    int CountCommentsRecursively(IEnumerable<OpinionHub.Web.ViewModels.CommentNodeViewModel> nodes)
    {
        var n = 0;
        foreach (var c in nodes) { n++; n += CountCommentsRecursively(c.Replies); }
        return n;
    }
}

<div class="oh-hero oh-hero--compact py-2 mb-2">
    <div class="container oh-page--wide">
        @if (TempData["EmailConfirmRequired"] is string emailConfirmMsg)
        {
            <div class="alert alert-warning mb-2 py-2 small">@emailConfirmMsg</div>
        }

        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (hasCover)
            {
                <img src="@Model.CoverImagePath" class="oh-hero__cover d-none d-sm-block" alt="Обложка" />
            }

            <div class="flex-grow-1" style="min-width:0;">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <h1 class="h5 oh-page-title oh-hero__title mb-0" style="min-width:0;">
                        <i class="bi bi-bar-chart-line"></i>
                        <span class="text-truncate">@Model.Title</span>
                    </h1>
                    <span class="badge rounded-pill @(
                        Model.Status == PollStatus.Active ? "text-bg-success" :
                        Model.Status == PollStatus.Draft ? "text-bg-warning" :
                        Model.Status == PollStatus.Completed ? "text-bg-secondary" : "text-bg-dark")">
                        @Model.Status
                    </span>
                </div>

                <div class="text-secondary small d-flex flex-wrap align-items-center gap-1 mt-1">
                    <span>Автор:</span>
                    @await Html.PartialAsync("_PollAuthor", new OpinionHub.Web.ViewModels.PollAuthorLinkViewModel(Model.IsAnonymousAuthor, Model.Author?.UserName))
                    <span class="mx-1">•</span>
                    <span>Голосов: <strong>@total</strong></span>
                    @if (Model.EndDateUtc is not null)
                    {
                        <span class="mx-1">•</span>
                        <span>До: <strong>@Model.EndDateUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</strong></span>
                    }
                    <span class="mx-1 d-none d-md-inline">•</span>
                    <span class="d-none d-md-inline">Тип: <strong>@Model.PollType</strong></span>
                    <span class="mx-1 d-none d-md-inline">•</span>
                    <span class="d-none d-md-inline">Видимость: <strong>@Model.VisibilityType</strong></span>
                    <span class="mx-1 d-none d-md-inline">•</span>
                    <span class="d-none d-md-inline">Доступ: <strong>@(Model.AudienceType == AudienceType.Everyone ? "Все" : "Выбранные")</strong></span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (canLike)
                {
                    <button id="poll-like-btn"
                            type="button"
                            class="btn btn-sm @(isLiked ? "btn-danger" : "btn-outline-danger") d-inline-flex align-items-center gap-2"
                            data-poll-id="@Model.Id"
                            data-liked="@(isLiked ? "true" : "false")"
                            aria-pressed="@(isLiked ? "true" : "false")"
                            title="@(isLiked ? "Снять лайк" : "Поставить лайк")">
                        <i class="bi @(isLiked ? "bi-heart-fill" : "bi-heart")"></i>
                        <span id="poll-like-count">@likeCount</span>
                    </button>
                }
                else
                {
                    <span class="btn btn-sm btn-outline-secondary disabled d-inline-flex align-items-center gap-2" title="Войдите, чтобы поставить лайк">
                        <i class="bi bi-heart"></i>
                        <span>@likeCount</span>
                    </span>
                }

                <a class="btn btn-sm btn-outline-secondary" asp-controller="Home" asp-action="Index" title="Назад в ленту">
                    <i class="bi bi-arrow-left"></i>
                    <span class="d-none d-md-inline ms-1">В ленту</span>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container oh-page--wide pb-4">
    @if (TempData["VoteError"] is string voteError)
    {
        <div class="alert alert-danger shadow-sm">@voteError</div>
    }

    @* Мобильные табы. На lg+ скрыты CSS-классом .oh-details-tabs. *@
    <ul class="nav nav-pills oh-details-tabs d-lg-none mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pane-vote" type="button" role="tab">
                <i class="bi bi-check2-square me-1"></i>Голосование
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-results" type="button" role="tab">
                <i class="bi bi-bar-chart me-1"></i>Результаты
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pane-comments" type="button" role="tab">
                <i class="bi bi-chat-left-text me-1"></i>Комменты
                <span class="text-secondary">(@totalCommentsCount)</span>
            </button>
        </li>
    </ul>

    <div class="tab-content oh-details-content">
        @* === Голосование === *@
        <div class="tab-pane fade show active oh-details-pane--vote" id="pane-vote" role="tabpanel">
            <section class="oh-pane">
                <header class="oh-pane__head">
                    <h2 class="oh-pane__title"><i class="bi bi-check2-square"></i>Голосование</h2>
                </header>
                <div class="oh-pane__body">
                    @if (Model.Status != PollStatus.Active)
                    {
                        <div class="alert alert-secondary py-2 small mb-0">Опрос не активен — голосование недоступно.</div>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="alert alert-light border py-2 small mb-3">Чтобы проголосовать, нужно войти в систему.</div>
                        <div class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-secondary" asp-area="Identity" asp-page="/Account/Login">Войти</a>
                            <a class="btn btn-sm btn-primary" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
                        </div>
                    }
                    else if (!isEmailConfirmed)
                    {
                        <div class="alert alert-warning py-2 small mb-0">
                            Чтобы голосовать, нужно подтвердить почту.
                            <a class="ms-2 fw-bold" asp-area="Identity" asp-page="/Account/ConfirmEmailCode" asp-route-userId="@myId" asp-route-returnUrl="@returnUrl">Подтвердить</a>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Vote" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="vstack gap-2">
                                @foreach (var option in Model.Options)
                                {
                                    <label class="oh-vote-option" for="opt-@option.Id">
                                        <input class="form-check-input"
                                               type="@(Model.PollType == PollType.SingleChoice ? "radio" : "checkbox")"
                                               name="optionIds"
                                               value="@option.Id"
                                               id="opt-@option.Id" />
                                        @if (!string.IsNullOrEmpty(option.ImagePath))
                                        {
                                            <img src="@option.ImagePath" class="vote-thumb" alt="Фото варианта" />
                                        }
                                        <span class="vote-text text-truncate">@option.Text</span>
                                    </label>
                                }
                            </div>

                            <button class="btn btn-primary w-100 mt-3">Проголосовать</button>

                            @if (Model.CanChangeVote)
                            {
                                <div class="form-text text-center mt-1">Вы можете изменить свой голос позже.</div>
                            }
                        </form>
                    }

                    @if (Model.Attachments != null && Model.Attachments.Any())
                    {
                        <div class="mt-3">
                            <h6 class="fw-bold mb-2 text-secondary small">Прикреплённые файлы</h6>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var file in Model.Attachments)
                                {
                                    <a href="@file.FilePath" target="_blank"
                                       class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 text-decoration-none"
                                       title="@file.OriginalFileName (@(Math.Round((double)file.FileSize / 1024, 1)) KB)">
                                        <i class="bi bi-file-earmark"></i>
                                        <span class="text-truncate" style="max-width:160px;">@file.OriginalFileName</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (isAuthor || User.Identity?.IsAuthenticated == true)
                {
                    <footer class="oh-pane__foot">
                        @if (isAuthor)
                        {
                            @if (Model.Status == PollStatus.Draft)
                            {
                                <form asp-action="Publish" method="post" class="mb-2">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button class="btn btn-sm btn-success w-100">Опубликовать черновик</button>
                                </form>
                            }

                            <div class="d-flex gap-2 mb-2">
                                <a class="btn btn-sm btn-outline-secondary flex-fill" asp-action="ExportCsv" asp-route-id="@Model.Id">CSV</a>
                                <a class="btn btn-sm btn-outline-secondary flex-fill" asp-action="ExportXlsx" asp-route-id="@Model.Id">XLSX</a>
                            </div>

                            <a href="https://t.me/share/url?url=@Url.Action("Details", "Polls", new { id = Model.Id }, Context.Request.Scheme)&text=@Uri.EscapeDataString("Проголосуй в опросе: " + Model.Title)"
                               target="_blank"
                               class="btn btn-sm btn-outline-info w-100 mb-2 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-telegram"></i>Поделиться в Telegram
                            </a>

                            <form asp-action="Delete" asp-controller="Polls" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Точно удаляем? Это действие необратимо.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">Удалить опрос</button>
                            </form>
                        }
                        else
                        {
                            <a href="https://t.me/share/url?url=@Url.
                               class="btn btn-sm btn-outline-info w-100 d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-telegram"></i>Поделиться в Telegram
                            </a>
                        }
                    </footer>
                }
            </section>
        </div>

        @* === Результаты + графики + AI === *@
        <div class="tab-pane fade oh-details-pane--results" id="pane-results" role="tabpanel">
            <section class="oh-pane">
                <header class="oh-pane__head d-flex justify-content-between align-items-center">
                    <h2 class="oh-pane__title"><i class="bi bi-bar-chart"></i>Результаты</h2>
                    <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 rounded-pill small">
                    </span>
                </header>
                <div class="oh-pane__body d-flex flex-column">
                    <div class="vstack gap-1 mb-3">
                        @foreach (var option in Model.Options)
                        {
                            var count = Model.Votes.Count(v => v.Selections.Any(s => s.PollOptionId == option.Id));
                            var pct = total == 0 ? 0 : count * 100.0 / total;

                            <div class="oh-stat-row">
                                <div class="oh-stat-row__label">
                                    @if (!string.IsNullOrEmpty(option.ImagePath))
                                    {
                                        <img src="@option.ImagePath" class="oh-stat-row__thumb" alt="" />
                                    }
                                    <span class="label-text">@option.Text</span>
                                </div>
                                <div class="oh-stat-row__count" id="stat-text-@option.Id">@count (@pct.ToString("F1")%)</div>
                                <div class="oh-stat-row__bar progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar bg-primary" id="stat-bar-@option.Id" style="width: @pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-start mb-2">
                        <ul class="nav nav-pills" id="chartTypeTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active py-1 px-3 small" id="tab-bar" data-chart="bar" type="button">Столбчатая</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link py-1 px-3 small" id="tab-pie" data-chart="pie" type="button">Круговая</button>
                            </li>
                        </ul>
                    </div>

                    <div class="oh-chart-wrap mb-2 flex-grow-1">
                        <canvas id="chart"></canvas>
                    </div>

                    <div class="mt-auto">
                        <button id="btnAnalyze" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-2" onclick="fetchAiAnalysis()">
                            <i class="bi bi-robot"></i>
                            <span id="btnText">Магический анализ результатов</span>
                            <div id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></div>
                        </button>

                        <div id="aiResultContainer" class="alert alert-info small mt-2 d-none mb-0">
                            <div class="d-flex align-items-center mb-1">
                                <div class="brand-dot me-2"></div>
                                <strong class="text-primary">Вердикт OpinionHub AI</strong>
                            </div>
                            <p id="aiResultText" class="mb-0 fst-italic"></p>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        @* === Комментарии === *@
        <div class="tab-pane fade oh-details-pane--comments" id="pane-comments" role="tabpanel">
            <section class="oh-pane">
                <header class="oh-pane__head">
                    <h2 class="oh-pane__title">
                        <i class="bi bi-chat-left-text"></i>Комментарии
                        <span class="text-secondary ms-1 fw-normal" id="comments-total">(@totalCommentsCount)</span>
                    </h2>
                </header>
                <div class="oh-pane__body">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var myName = User.Identity.Name ?? "";
                        var myInitial = myName.Length > 0 ? myName[0].ToString().ToUpper() : "?";
                        <form id="comment-root-form" class="oh-composer is-collapsed mb-3" data-attach-scope="root">
                            <div class="oh-composer-avatar">@myInitial</div>
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="oh-composer-pill">
                                    <textarea class="oh-composer-input"
                                              name="text"
                                              rows="1"
                                              maxlength="2000"
                                              placeholder="Напишите комментарий..."></textarea>
                                    <input type="file"
                                           class="oh-composer-file d-none"
                                           accept="image/jpeg,image/png,image/webp,image/gif" />
                                    <button type="button"
                                            class="oh-composer-icon-btn oh-composer-attach"
                                            title="Прикрепить фото (только одно)"
                                            aria-label="Прикрепить фото">
                                        <i class="bi bi-paperclip"></i>
                                    </button>
                                    <button type="submit"
                                            class="btn btn-primary oh-composer-send"
                                            title="Отправить"
                                            aria-label="Отправить">
                                        <i class="bi bi-send-fill"></i>
                                    </button>
                                </div>
                                <div class="oh-composer-preview d-none">
                                    <img alt="Превью" />
                                    <div class="meta">
                                        <span class="filename"></span>
                                        <span class="hint">Только одно фото · до 5 МБ</span>
                                    </div>
                                    <button type="button" class="remove-btn" title="Убрать" aria-label="Убрать вложение">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-light border small mb-3">
                            <a asp-area="Identity" asp-page="/Account/Login">Войдите</a>, чтобы оставить комментарий.
                        </div>
                    }

                    <div id="comments-list">
                        @if (comments.Count == 0)
                        {
                            <div id="comments-empty" class="text-center py-4 text-secondary small">
                                Пока нет ни одного комментария. Будьте первым!
                            </div>
                        }
                        else
                        {
                            foreach (var node in comments)
                            {
                                @await Html.PartialAsync("_Comment", node)
                            }
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <section class="oh-pane mt-3">
            <header class="oh-pane__head">
                <h2 class="oh-pane__title"><i class="bi bi-text-paragraph"></i>Описание</h2>
            </header>
            <div class="oh-pane__body">
                <p class="mb-0" style="white-space: pre-wrap; word-wrap: break-word;">@Model.Description</p>
            </div>
        </section>
    }
</div>

@* Lightbox — модалка для просмотра вложения комментария во весь экран *@
<div class="modal fade" id="comment-image-modal" tabindex="-1" aria-hidden="true" aria-labelledby="comment-image-modal-label">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0 shadow-none">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                    data-bs-dismiss="modal" aria-label="Закрыть" style="z-index:2;"></button>
            <img src="" alt="Вложение" id="comment-image-modal-label"
                 class="img-fluid rounded shadow-lg mx-auto d-block"
                 style="max-height: 90vh; object-fit: contain; background: rgba(0,0,0,0.2);" />
        </div>
    </div>
</div>

@section Scripts {
    <input type="hidden" id="af-token" value="@afTokens.RequestToken" />
    <script src="~/js/poll-details.js" asp-append-version="true"></script>
    <script src="~/js/poll-comments.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const pollId = '@Model.Id';
            const labels = @Html.Raw(Json.Serialize(Model.Options.Select(o => o.Text)));
            const data = @Html.Raw(Json.Serialize(Model.Options.Select(o => Model.Votes.Count(v => v.Selections.Any(s => s.PollOptionId == o.Id)))));

            initPollDetails(pollId, labels, data);

            // === Лайк опроса ===
            const likeBtn = document.getElementById('poll-like-btn');
            if (likeBtn) {
                const tokenEl = document.getElementById('af-token');
                const countEl = document.getElementById('poll-like-count');
                const iconEl = likeBtn.querySelector('i');
                const url = '/api/likes/polls/' + likeBtn.dataset.pollId;

                likeBtn.addEventListener('click', async function () {
                    const liked = likeBtn.dataset.liked === 'true';
                    likeBtn.disabled = true;
                    try {
                        const connId = typeof window.getSignalrConnectionId === 'function'
                            ? (window.getSignalrConnectionId() || '')
                            : '';
                        const resp = await fetch(url, {
                            method: liked ? 'DELETE' : 'POST',
                            headers: {
                                'RequestVerificationToken': tokenEl.value,
                                'X-SignalR-Connection-Id': connId,
                                'Accept': 'application/json'
                            },
                            credentials: 'same-origin'
                        });
                        if (!resp.ok) {
                            console.error('Like error:', resp.status, await resp.text());
                            return;
                        }
                        const payload = await resp.json();
                        likeBtn.dataset.liked = payload.liked ? 'true' : 'false';
                        likeBtn.setAttribute('aria-pressed', payload.liked ? 'true' : 'false');
                        likeBtn.title = payload.liked ? 'Снять лайк' : 'Поставить лайк';
                        countEl.textContent = payload.count;
                        if (payload.liked) {
                            likeBtn.classList.remove('btn-outline-danger');
                            likeBtn.classList.add('btn-danger');
                            iconEl.classList.remove('bi-heart');
                            iconEl.classList.add('bi-heart-fill');
                        } else {
                            likeBtn.classList.remove('btn-danger');
                            likeBtn.classList.add('btn-outline-danger');
                            iconEl.classList.remove('bi-heart-fill');
                            iconEl.classList.add('bi-heart');
                        }
                    } catch (err) {
                        console.error('Like network error:', err);
                    } finally {
                        likeBtn.disabled = false;
                    }
                });
            }
        });

        async function fetchAiAnalysis() {
            const btn = document.getElementById('btnAnalyze');
            const btnText = document.getElementById('btnText');
            const spinner = document.getElementById('btnSpinner');
            const container = document.getElementById('aiResultContainer');
            const textPath = document.getElementById('aiResultText');

            btn.disabled = true;
            btnText.innerText = "ИИ думает...";
            spinner.classList.remove('d-none');

            try {
                const response = await fetch(`/Polls/GetAiAnalysis?id=@Model.Id`);
                const data = await response.json();

                if (response.ok) {
                    textPath.innerText = `"${data.analysis}"`;
                    container.classList.remove('d-none');
                    container.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                } else {
                    alert("Ошибка: не удалось получить данные от ИИ.");
                }
            } catch (error) {
                console.error("Ошибка аналитики:", error);
                alert("Произошла ошибка при связи с сервером.");
            } finally {
                btn.disabled = false;
                btnText.innerText = "Обновить анализ";
                spinner.classList.add('d-none');
            }
        }
    </script>
}
