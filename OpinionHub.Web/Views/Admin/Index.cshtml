@model OpinionHub.Web.Models.Admin.AdminIndexVm
@using OpinionHub.Web.Models.Admin

@{
    ViewData["Title"] = "Управление пользователями";
    ViewData["AdminSidebarActive"] = Model.Status switch
    {
        AdminUserFilter.Active => "active",
        AdminUserFilter.Banned => "banned",
        AdminUserFilter.Deleted => "deleted",
        AdminUserFilter.Admin => "admin",
        _ => "all"
    };
    ViewData["AdminCountAll"] = Model.CountAll;
    ViewData["AdminCountActive"] = Model.CountActive;
    ViewData["AdminCountBanned"] = Model.CountBanned;
    ViewData["AdminCountDeleted"] = Model.CountDeleted;
    ViewData["AdminCountAdmin"] = Model.CountAdmin;
    ViewData["AdminPendingReports"] = Model.PendingReports;
    ViewData["AdminPendingAppeals"] = Model.PendingAppeals;

    string SortLink(AdminUserSort asc, AdminUserSort desc)
    {
        if (Model.Sort == asc) return desc.ToString();
        return asc.ToString();
    }

    string SortIcon(AdminUserSort asc, AdminUserSort desc) => Model.Sort == asc
        ? "<i class=\"bi bi-arrow-up\"></i>"
        : Model.Sort == desc
            ? "<i class=\"bi bi-arrow-down\"></i>"
            : "<i class=\"bi bi-arrow-down-up text-muted\"></i>";

    string StatusTitle = Model.Status switch
    {
        AdminUserFilter.Active => "Активные",
        AdminUserFilter.Banned => "Заблокированные",
        AdminUserFilter.Deleted => "Удалённые",
        AdminUserFilter.Admin => "Администраторы",
        _ => "Все пользователи"
    };
}

<div class="oh-hero py-4 py-md-5 mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="display-6 mb-1">Панель администратора</h1>
                <p class="text-secondary mb-0">Управление пользователями, ролями и блокировками.</p>
            </div>
            <a class="btn btn-primary shadow-sm" asp-action="Create">+ Создать пользователя</a>
        </div>
    </div>
</div>

<div class="container pb-5">
    @if (TempData["AdminMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success shadow-sm">@ok</div>
    }
    @if (TempData["AdminError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger shadow-sm" style="white-space:pre-line">@err</div>
    }

    <div class="row g-4">
        <aside class="col-12 col-lg-3">
            <partial name="_AdminSidebar" />
        </aside>

        <div class="col-12 col-lg-9">
            <div class="card border-0 shadow-sm oh-card">
                <div class="card-header bg-white border-bottom p-4 d-flex flex-wrap gap-3 align-items-center justify-content-between">
                    <h5 class="mb-0 fw-bold">@StatusTitle</h5>

                    <form method="get" asp-action="Index" class="d-flex gap-2">
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="sort" value="@Model.Sort" />
                        <input class="form-control bg-light border-0" style="width: 250px;" name="q" value="@Model.Query" placeholder="Поиск по логину/email..." />
                        <button class="btn btn-secondary" type="submit">Найти</button>
                        @if (!string.IsNullOrEmpty(Model.Query))
                        {
                            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" title="Сбросить поиск">✕</a>
                        }
                    </form>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-4">
                                        <a class="text-decoration-none text-secondary"
                                           asp-action="Index"
                                           asp-route-status="@Model.Status"
                                           asp-route-q="@Model.Query"
                                           asp-route-sort="@SortLink(AdminUserSort.UserNameAsc, AdminUserSort.UserNameDesc)">
                                            Пользователь @Html.Raw(SortIcon(AdminUserSort.UserNameAsc, AdminUserSort.UserNameDesc))
                                        </a>
                                    </th>
                                    <th>
                                        <a class="text-decoration-none text-secondary"
                                           asp-action="Index"
                                           asp-route-status="@Model.Status"
                                           asp-route-q="@Model.Query"
                                           asp-route-sort="@SortLink(AdminUserSort.EmailAsc, AdminUserSort.EmailDesc)">
                                            Email @Html.Raw(SortIcon(AdminUserSort.EmailAsc, AdminUserSort.EmailDesc))
                                        </a>
                                    </th>
                                    <th>Роли</th>
                                    <th>Статус</th>
                                    <th class="text-end pe-4" style="width: 320px">Действия</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var u in Model.Users)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            @if (u.IsDeleted)
                                            {
                                                <span class="fw-bold text-muted">@u.UserName</span>
                                            }
                                            else
                                            {
                                                <a asp-controller="Profile" asp-action="Index" asp-route-userName="@u.UserName"
                                                   class="fw-bold text-decoration-none text-dark">@u.UserName</a>
                                            }
                                            <div class="text-muted font-monospace" style="font-size: 0.75rem">@u.Id</div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(u.Email))
                                            {
                                                <a href="mailto:@u.Email" class="text-decoration-none">@u.Email</a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td>
                                            @if (u.Roles.Count == 0)
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                            else
                                            {
                                                @foreach (var role in u.Roles)
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle me-1">@role</span>
                                                }
                                            }
                                        </td>
                                        <td>
                                            @if (u.IsDeleted)
                                            {
                                                <span class="badge bg-secondary"><i class="bi bi-person-x me-1"></i>Удалён</span>
                                                @if (u.DeletedAt is not null)
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 0.75rem">
                                                        @u.DeletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                                    </div>
                                                }
                                            }
                                            else if (u.IsLockedOut)
                                            {
                                                <span class="badge bg-danger">Заблокирован</span>
                                                <div class="text-muted mt-1" style="font-size: 0.75rem">
                                                    до: @(u.LockoutEndUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "навсегда")
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(u.BanReason))
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 0.75rem; white-space: pre-wrap;" title="@u.BanReason">
                                                        Причина: @(u.BanReason.Length > 60 ? u.BanReason.Substring(0, 60) + "…" : u.BanReason)
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle">Активен</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <div class="d-flex flex-wrap justify-content-end gap-2">
                                                @if (u.IsDeleted)
                                                {
                                                    <span class="text-muted small fst-italic">Аккаунт удалён</span>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Изменить</a>
                                                    <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@u.Id">Пароль</a>

                                                    if (u.IsLockedOut)
                                                    {
                                                        <form asp-action="Unlock" asp-route-id="@u.Id" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <button class="btn btn-sm btn-success" type="submit" title="Снять блокировку">Разбан</button>
                                                        </form>
                                                    }
                                                    else
                                                    {
                                                        <a class="btn btn-sm btn-warning" asp-action="Lockout" asp-route-id="@u.Id">Бан</a>
                                                    }

                                                    <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Удалить пользователя @u.UserName? Личные данные будут стёрты, но его комментарии и опросы останутся как «Удалённый аккаунт».');">
                                                        @Html.AntiForgeryToken()
                                                        <button class="btn btn-sm btn-outline-danger" type="submit">✕</button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (Model.Users.Count == 0)
                {
                    <div class="card-body text-center py-5 text-muted">
                        <i class="bi bi-people fs-1 d-block mb-2"></i>
                        <p class="mb-0">Пользователи не найдены.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
