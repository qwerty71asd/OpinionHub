@model OpinionHub.Web.Models.Admin.AdminUserEditVm

@{
    ViewData["Title"] = "Изменить пользователя";
}

<div class="oh-hero py-4 py-md-5 mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="display-6 mb-1">Изменить пользователя</h1>
                <p class="text-secondary mb-0">Редактирование данных учетной записи: @Model.UserName</p>
            </div>
            <a class="btn btn-outline-secondary" asp-action="Index">
                ← К списку
            </a>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm oh-card" style="background: var(--bs-body-bg); opacity: 0.95;">
                <div class="card-body p-4 p-md-5">

                    <form method="post" class="row g-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="col-12">
                            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label fw-bold"></label>
                            <input asp-for="UserName" class="form-control" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 d-flex align-items-center mt-md-4 pt-md-3">
                            <div class="form-check form-switch fs-5 mb-0">
                                <input asp-for="EmailConfirmed" class="form-check-input" id="emailConfirmedSwitch" />
                                <label asp-for="EmailConfirmed" class="form-check-label fs-6 ms-2 text-body" for="emailConfirmedSwitch"></label>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold mb-3">Роль</label>
                            <div class="p-3 border rounded" style="background: rgba(128,128,128,0.05);">
                                <div class="d-flex flex-wrap gap-4">
                                    @foreach (var r in Model.AvailableRoles)
                                    {
                                        var checkedNow = string.Equals(Model.SelectedRole, r, StringComparison.OrdinalIgnoreCase);
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="SelectedRole" value="@r" id="role_@r" @(checkedNow ? "checked" : "") />
                                            <label class="form-check-label text-body" for="role_@r">@r</label>
                                        </div>
                                    }
                                </div>
                                <span asp-validation-for="SelectedRole" class="text-danger small d-block mt-2"></span>
                                <div class="form-text">У пользователя может быть только одна роль одновременно.</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="alert alert-warning mb-0 border-0 shadow-sm" style="background: rgba(255, 193, 7, 0.1);">
                                <div class="text-body"><b>LockoutEnd (UTC)</b>: @(Model.LockoutEndUtc?.ToString("u") ?? "—")</div>
                                <div class="text-muted mt-1" style="font-size: 0.85rem">Для блокировки или разблокировки пользователя используйте соответствующие кнопки в главном списке панели администратора.</div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="col-12 d-flex flex-column flex-md-row justify-content-end gap-3">
                            <a class="btn btn-light border px-4" asp-action="Index">Отмена</a>
                            <button class="btn btn-primary px-5 fw-bold shadow-sm" type="submit">Сохранить изменения</button>
                        </div>
                    </form>

                </div>
            </div>

            @* === Подробная админка: контент пользователя === *@
            <div class="card border-0 shadow-sm oh-card mt-4">
                <div class="card-body p-4">
                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-polls" type="button" role="tab">
                                <i class="bi bi-list-check me-1"></i>Опросы
                                <span class="badge bg-secondary ms-1">@Model.RecentPolls.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-comments" type="button" role="tab">
                                <i class="bi bi-chat-left-text me-1"></i>Комментарии
                                <span class="badge bg-secondary ms-1">@Model.RecentComments.Count</span>
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-against" type="button" role="tab">
                                <i class="bi bi-flag me-1"></i>Жалобы на пользователя
                                <span class="badge bg-warning text-dark ms-1">@Model.ReportsAgainstCount</span>
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="tab-polls" role="tabpanel">
                            @if (Model.RecentPolls.Count == 0)
                            {
                                <p class="text-muted small mb-0">У пользователя нет публичных опросов (анонимные не отображаются).</p>
                            }
                            else
                            {
                                <div class="vstack gap-2">
                                    @foreach (var p in Model.RecentPolls)
                                    {
                                        <div class="d-flex justify-content-between align-items-center border rounded p-2 @(p.IsDeleted ? "opacity-50" : "")">
                                            <div class="me-2" style="min-width:0;">
                                                <div class="fw-semibold text-truncate">@p.Title</div>
                                                <div class="text-muted small">
                                                    @p.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @p.Status
                                                    @if (p.IsDeleted)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger ms-1">удалён</span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                                <a class="btn btn-sm btn-outline-primary" asp-controller="Polls" asp-action="Details" asp-route-id="@p.Id" target="_blank">Открыть</a>
                                                @if (!p.IsDeleted)
                                                {
                                                    <form asp-controller="Polls" asp-action="AdminDelete" asp-route-id="@p.Id" method="post"
                                                          onsubmit="return confirm('Удалить опрос как админ?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="tab-pane fade" id="tab-comments" role="tabpanel">
                            @if (Model.RecentComments.Count == 0)
                            {
                                <p class="text-muted small mb-0">У пользователя нет комментариев под публичными опросами.</p>
                            }
                            else
                            {
                                <div class="vstack gap-2">
                                    @foreach (var c in Model.RecentComments)
                                    {
                                        <div class="border rounded p-2 @(c.IsDeleted ? "opacity-50" : "")">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div class="me-2 small" style="min-width:0;">
                                                    <div style="white-space:pre-wrap; word-break:break-word;">
                                                        @if (c.IsDeleted)
                                                        {
                                                            <em class="text-muted">Комментарий удалён</em>
                                                        }
                                                        else
                                                        {
                                                            @(c.Text.Length > 200 ? c.Text.Substring(0, 200) + "…" : c.Text)
                                                        }
                                                    </div>
                                                    <div class="text-muted mt-1">
                                                        @c.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ·
                                                        под опросом
                                                        <a asp-controller="Polls" asp-action="Details" asp-route-id="@c.PollId" target="_blank">@c.PollTitle</a>
                                                    </div>
                                                </div>
                                                @if (!c.IsDeleted)
                                                {
                                                    <form asp-controller="Comments" asp-action="AdminDelete" asp-route-id="@c.Id" method="post"
                                                          onsubmit="return confirm('Удалить комментарий как админ?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="tab-pane fade" id="tab-against" role="tabpanel">
                            @if (Model.ReportsAgainstCount == 0)
                            {
                                <p class="text-muted small mb-0">На пользователя нет жалоб.</p>
                            }
                            else
                            {
                                <p class="small mb-0">
                                    Подано жалоб: <strong>@Model.ReportsAgainstCount</strong>.
                                    Подробности — на странице <a asp-action="Reports">«Жалобы»</a>.
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>