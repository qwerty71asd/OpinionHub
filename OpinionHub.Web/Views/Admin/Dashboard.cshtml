@model OpinionHub.Web.Models.Admin.AdminDashboardVm
@using OpinionHub.Web.Models

@{
    ViewData["Title"] = "Дашборд";
    ViewData["AdminSidebarActive"] = "dashboard";
    ViewData["AdminCountAll"] = Model.CountAll;
    ViewData["AdminCountActive"] = Model.CountActive;
    ViewData["AdminCountBanned"] = Model.CountBanned;
    ViewData["AdminCountDeleted"] = Model.CountDeleted;
    ViewData["AdminCountAdmin"] = Model.CountAdmin;
    ViewData["AdminPendingReports"] = Model.PendingReports;
    ViewData["AdminPendingAppeals"] = Model.PendingAppeals;

    var statusLabels = new Dictionary<PollStatus, string>
    {
        [PollStatus.Draft] = "Черновики",
        [PollStatus.Active] = "Активные",
        [PollStatus.Completed] = "Завершённые",
        [PollStatus.Archived] = "Архив"
    };

    var orderedStatuses = new[] { PollStatus.Active, PollStatus.Draft, PollStatus.Completed, PollStatus.Archived };
    var pieLabels = orderedStatuses.Where(s => Model.StatusBreakdown.ContainsKey(s)).Select(s => statusLabels[s]).ToList();
    var pieData = orderedStatuses.Where(s => Model.StatusBreakdown.ContainsKey(s)).Select(s => Model.StatusBreakdown[s]).ToList();
}

<div class="oh-hero py-4 py-md-5 mb-4">
    <div class="container">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div>
                <h1 class="display-6 mb-1"><i class="bi bi-speedometer2 me-2"></i>Дашборд</h1>
                <p class="text-secondary mb-0">Краткая сводка по проекту: пользователи, опросы, активность.</p>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">
        <aside class="col-12 col-lg-3">
            <partial name="_AdminSidebar" />
        </aside>

        <div class="col-12 col-lg-9">
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <div class="text-secondary small mb-1"><i class="bi bi-people me-1"></i>Пользователи</div>
                            <div class="display-6 fw-bold mb-0">@Model.TotalUsers</div>
                            <div class="text-success small mt-1"><i class="bi bi-activity me-1"></i>+@Model.ActiveUsersWeek активных за неделю</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <div class="text-secondary small mb-1"><i class="bi bi-bar-chart me-1"></i>Опросов</div>
                            <div class="display-6 fw-bold mb-0">@Model.TotalPolls</div>
                            <div class="text-success small mt-1"><i class="bi bi-plus-circle me-1"></i>+@Model.NewPollsWeek за неделю</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <div class="text-secondary small mb-1"><i class="bi bi-check2-square me-1"></i>Голосов</div>
                            <div class="display-6 fw-bold mb-0">@Model.TotalVotes</div>
                            <div class="text-success small mt-1"><i class="bi bi-graph-up me-1"></i>+@Model.VotesWeek за неделю</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <div class="text-secondary small mb-1"><i class="bi bi-flag me-1"></i>Модерация</div>
                            <div class="display-6 fw-bold mb-0">@(Model.PendingReports + Model.PendingAppeals)</div>
                            <div class="small mt-1">
                                <span class="text-warning"><i class="bi bi-flag me-1"></i>@Model.PendingReports жалоб</span>
                                <span class="text-info ms-2"><i class="bi bi-megaphone me-1"></i>@Model.PendingAppeals апелляций</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <h6 class="oh-section-title mb-3"><i class="bi bi-graph-up"></i>Голоса за 30 дней</h6>
                            <div style="position: relative; height: 280px;">
                                <canvas id="chartVotes30"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm oh-card h-100">
                        <div class="card-body">
                            <h6 class="oh-section-title mb-3"><i class="bi bi-pie-chart"></i>Статусы опросов</h6>
                            <div style="position: relative; height: 280px;">
                                <canvas id="chartStatuses"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm oh-card">
                <div class="card-body">
                    <h6 class="oh-section-title mb-3"><i class="bi bi-trophy"></i>Топ-10 опросов по голосам</h6>
                    @if (Model.TopPolls.Count == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            <p class="mb-0">Пока нет опросов с голосами.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light text-secondary">
                                    <tr>
                                        <th style="width: 40px">#</th>
                                        <th>Название</th>
                                        <th class="text-end" style="width: 110px">Голосов</th>
                                        <th style="width: 180px">Автор</th>
                                        <th style="width: 140px">Создан</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @for (int i = 0; i < Model.TopPolls.Count; i++)
                                {
                                    var p = Model.TopPolls[i];
                                    <tr>
                                        <td class="text-muted">@(i + 1)</td>
                                        <td>
                                            <a asp-controller="Polls" asp-action="Details" asp-route-id="@p.Id"
                                               class="text-decoration-none fw-semibold text-body">@p.Title</a>
                                        </td>
                                        <td class="text-end fw-bold">@p.VoteCount</td>
                                        <td>@(p.AuthorName ?? "(удалён)")</td>
                                        <td class="text-muted small">@p.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const palette = ['#0d6efd', '#6610f2', '#6f42c1', '#d63384', '#fd7e14',
                             '#198754', '#20c997', '#0dcaf0', '#ffc107', '#6c757d'];

            const votesLabels = @Html.Raw(Json.Serialize(Model.ChartLabels));
            const votesData = @Html.Raw(Json.Serialize(Model.ChartData));

            new Chart(document.getElementById('chartVotes30'), {
                type: 'line',
                data: {
                    labels: votesLabels,
                    datasets: [{
                        label: 'Голосов в день',
                        data: votesData,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 2,
                        pointHoverRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });

            const pieLabels = @Html.Raw(Json.Serialize(pieLabels));
            const pieData = @Html.Raw(Json.Serialize(pieData));

            new Chart(document.getElementById('chartStatuses'), {
                type: 'doughnut',
                data: {
                    labels: pieLabels,
                    datasets: [{
                        data: pieData,
                        backgroundColor: palette.slice(0, pieLabels.length),
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        })();
    </script>
}
