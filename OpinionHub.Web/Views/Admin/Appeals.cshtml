@model OpinionHub.Web.Models.Admin.AdminAppealsVm
@using OpinionHub.Web.Models
@using OpinionHub.Web.Models.Admin

@{
    ViewData["Title"] = "Апелляции";
    ViewData["AdminSidebarActive"] = "appeals";
    ViewData["AdminCountAll"] = Model.CountAll;
    ViewData["AdminCountActive"] = Model.CountActive;
    ViewData["AdminCountBanned"] = Model.CountBanned;
    ViewData["AdminCountDeleted"] = Model.CountDeleted;
    ViewData["AdminCountAdmin"] = Model.CountAdmin;
    ViewData["AdminPendingReports"] = Model.PendingReports;
    ViewData["AdminPendingAppeals"] = Model.PendingAppeals;

    string StatusLabel(AppealStatus s) => s switch
    {
        AppealStatus.Pending => "На рассмотрении",
        AppealStatus.Approved => "Одобрено",
        AppealStatus.Rejected => "Отклонено",
        _ => s.ToString()
    };
    string StatusClass(AppealStatus s) => s switch
    {
        AppealStatus.Approved => "bg-success-subtle text-success",
        AppealStatus.Rejected => "bg-danger-subtle text-danger",
        _ => "bg-warning-subtle text-warning"
    };
    string StatusFilterLabel(AdminAppealStatusFilter s) => s switch
    {
        AdminAppealStatusFilter.All => "Все",
        AdminAppealStatusFilter.Pending => "На рассмотрении",
        AdminAppealStatusFilter.Reviewed => "Рассмотренные",
        AdminAppealStatusFilter.Approved => "Одобренные",
        AdminAppealStatusFilter.Rejected => "Отклонённые",
        _ => s.ToString()
    };
}

<div class="oh-hero py-4 py-md-5 mb-4">
    <div class="container">
        <h1 class="display-6 mb-1">Апелляции</h1>
        <p class="text-secondary mb-0">Запросы пользователей на снятие блокировки.</p>
    </div>
</div>

<div class="container pb-5">
    @if (TempData["AdminMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
    {
        <div class="alert alert-success shadow-sm">@ok</div>
    }
    @if (TempData["AdminError"] is string err && !string.IsNullOrWhiteSpace(err))
    {
        <div class="alert alert-danger shadow-sm">@err</div>
    }

    <div class="row g-4">
        <aside class="col-12 col-lg-3">
            <partial name="_AdminSidebar" />
        </aside>

        <div class="col-12 col-lg-9">
            <form method="get" class="row g-2 mb-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Статус</label>
                    <select name="status" class="form-select form-select-sm">
                        @foreach (var s in Enum.GetValues<AdminAppealStatusFilter>())
                        {
                            <option value="@s" selected="@(Model.StatusFilter == s)">@StatusFilterLabel(s)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Пользователь</label>
                    <input name="user" class="form-control form-control-sm" placeholder="Логин или ID" value="@Model.UserQuery" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Сортировка</label>
                    <select name="sort" class="form-select form-select-sm">
                        <option value="DateDesc" selected="@(Model.Sort == AdminAppealSort.DateDesc)">Новые сверху</option>
                        <option value="DateAsc" selected="@(Model.Sort == AdminAppealSort.DateAsc)">Старые сверху</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1">
                        <i class="bi bi-funnel me-1"></i>Применить
                    </button>
                    <a asp-action="Appeals" class="btn btn-sm btn-outline-secondary" title="Сбросить">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </form>

            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-pending" type="button" role="tab">
                        <i class="bi bi-hourglass-split me-1"></i>Нерассмотренные
                        <span class="badge bg-warning text-dark ms-1">@Model.Pending.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-reviewed" type="button" role="tab">
                        <i class="bi bi-check2-all me-1"></i>Рассмотренные
                        <span class="badge bg-secondary ms-1">@Model.Reviewed.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                @foreach (var pane in new[] { ("pending", Model.Pending, true), ("reviewed", Model.Reviewed, false) })
                {
                    <div class="tab-pane fade @(pane.Item3 ? "show active" : "")" id="tab-@pane.Item1" role="tabpanel">
                        @if (pane.Item2.Count == 0)
                        {
                            <div class="card border-0 shadow-sm oh-card">
                                <div class="card-body text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    <p class="mb-0">Апелляций нет.</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="vstack gap-3">
                                @foreach (var a in pane.Item2)
                                {
                                    <div class="card border-0 shadow-sm oh-card">
                                        <div class="card-body p-3">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                                <div>
                                                    <span class="badge @StatusClass(a.Status)">@StatusLabel(a.Status)</span>
                                                    <span class="text-muted small ms-2">@a.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                </div>
                                                <div class="text-muted small">
                                                    Пользователь:
                                                    @if (!string.IsNullOrEmpty(a.UserName) && !string.IsNullOrEmpty(a.UserId))
                                                    {
                                                        <a asp-controller="Admin" asp-action="Edit" asp-route-id="@a.UserId" title="Открыть в админке">@a.UserName</a>
                                                    }
                                                    else if (!string.IsNullOrEmpty(a.UserName))
                                                    {
                                                        <span>@a.UserName</span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </div>
                                            </div>

                                            <div class="mb-2">
                                                <div class="text-secondary small mb-1">Причина бана (на момент подачи):</div>
                                                <div class="bg-light rounded p-2 small" style="white-space:pre-wrap;">
                                                    @if (!string.IsNullOrWhiteSpace(a.BanReasonSnapshot))
                                                    {
                                                        @a.BanReasonSnapshot
                                                    }
                                                    else
                                                    {
                                                        <em class="text-muted">причина не указана</em>
                                                    }
                                                </div>
                                                @if (a.BanCreatedAtSnapshot.HasValue)
                                                {
                                                    <div class="text-muted small mt-1">Бан выдан: @a.BanCreatedAtSnapshot.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                                                }
                                            </div>

                                            <div class="mb-2">
                                                <div class="text-secondary small mb-1">Сообщение от пользователя:</div>
                                                <div class="border rounded p-2" style="white-space:pre-wrap; word-break:break-word;">@a.Message</div>
                                            </div>

                                            @{
                                                var history = !string.IsNullOrEmpty(a.UserId) ? Model.History.GetValueOrDefault(a.UserId) : null;
                                            }
                                            @if (history is not null && history.Total > 0)
                                            {
                                                <details class="mt-2 small">
                                                    <summary class="text-muted" style="cursor:pointer;">
                                                        <i class="bi bi-clock-history me-1"></i>
                                                        История: всего <strong>@history.Total</strong>
                                                        @if (history.Approved > 0)
                                                        {
                                                            <span class="text-success ms-1">· одобрено @history.Approved</span>
                                                        }
                                                        @if (history.Rejected > 0)
                                                        {
                                                            <span class="text-danger ms-1">· отклонено @history.Rejected</span>
                                                        }
                                                        @if (history.Pending > 0)
                                                        {
                                                            <span class="text-warning ms-1">· в ожидании @history.Pending</span>
                                                        }
                                                    </summary>
                                                    <div class="mt-2 ps-3 border-start">
                                                        @foreach (var h in history.Items.Take(20))
                                                        {
                                                            <div class="mb-2">
                                                                <span class="badge @StatusClass(h.Status)">@StatusLabel(h.Status)</span>
                                                                <span class="text-muted ms-1">@h.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                                @if (!string.IsNullOrWhiteSpace(h.AdminResponse))
                                                                {
                                                                    var resp = h.AdminResponse.Length > 200 ? h.AdminResponse.Substring(0, 200) + "…" : h.AdminResponse;
                                                                    <div class="text-secondary mt-1" style="white-space:pre-wrap; word-break:break-word;">@resp</div>
                                                                }
                                                            </div>
                                                        }
                                                        @if (history.Items.Count > 20)
                                                        {
                                                            <div class="text-muted">…и ещё @(history.Items.Count - 20)</div>
                                                        }
                                                    </div>
                                                </details>
                                            }

                                            @if (a.Status != AppealStatus.Pending)
                                            {
                                                <div class="text-muted small mt-2">
                                                    <i class="bi bi-check2-all me-1"></i>
                                                    @if (a.ReviewedAtUtc is not null)
                                                    {
                                                        <span>@a.ReviewedAtUtc.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(a.ReviewedByUserName))
                                                    {
                                                        <span> · @a.ReviewedByUserName</span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(a.AdminResponse))
                                                    {
                                                        <div class="bg-light rounded p-2 mt-1" style="white-space:pre-wrap;">@a.AdminResponse</div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="row g-2 mt-2">
                                                    <div class="col-md-6">
                                                        <form asp-action="ApproveAppeal" asp-route-id="@a.Id" method="post" class="d-flex gap-2">
                                                            @Html.AntiForgeryToken()
                                                            <input class="form-control form-control-sm" name="response" placeholder="Ответ пользователю..." maxlength="1000" />
                                                            <button type="submit" class="btn btn-sm btn-success">
                                                                <i class="bi bi-unlock me-1"></i>Одобрить
                                                            </button>
                                                        </form>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <form asp-action="RejectAppeal" asp-route-id="@a.Id" method="post" class="d-flex gap-2">
                                                            @Html.AntiForgeryToken()
                                                            <input class="form-control form-control-sm" name="response" placeholder="Поясните причину отказа..." maxlength="1000" />
                                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                                <i class="bi bi-x-lg me-1"></i>Отклонить
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                                @if (!a.StillBanned)
                                                {
                                                    <div class="alert alert-info mt-2 mb-0 small">
                                                        <i class="bi bi-info-circle me-1"></i>Пользователь уже разблокирован (вручную). Одобрение апелляции просто закроет её.
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
