@*
    Sidebar админки (стиль Gmail): фильтры пользователей по статусу + ссылки
    на вкладки "Жалобы" и "Апелляции". Текущая активная категория передаётся через
    ViewData["AdminSidebarActive"] (значения: all/active/banned/deleted/admin/reports/appeals).
    Счётчики передаются по конкретным ViewData-ключам — у каждой страницы свой источник.
*@
@{
    var active = (ViewData["AdminSidebarActive"] as string) ?? "all";
    int countAll = (int)(ViewData["AdminCountAll"] ?? 0);
    int countActive = (int)(ViewData["AdminCountActive"] ?? 0);
    int countBanned = (int)(ViewData["AdminCountBanned"] ?? 0);
    int countDeleted = (int)(ViewData["AdminCountDeleted"] ?? 0);
    int countAdmin = (int)(ViewData["AdminCountAdmin"] ?? 0);
    int pendingReports = (int)(ViewData["AdminPendingReports"] ?? 0);
    int pendingAppeals = (int)(ViewData["AdminPendingAppeals"] ?? 0);

    string CategoryClass(string key) =>
        "list-group-item list-group-item-action d-flex justify-content-between align-items-center" +
        (active == key ? " active" : "");

    string BadgeClass(string key) =>
        active == key ? "badge bg-white text-primary" : "badge bg-secondary";
}

<div class="card border-0 shadow-sm oh-card sticky-top" style="top: 80px;">
    <div class="card-body p-3">
        <h6 class="text-uppercase text-muted small fw-bold mb-2 px-1">Пользователи</h6>
        <div class="list-group list-group-flush">
            <a class="@CategoryClass("all")" asp-controller="Admin" asp-action="Index">
                <span><i class="bi bi-people me-2"></i>Все</span>
                <span class="@BadgeClass("all")">@countAll</span>
            </a>
            <a class="@CategoryClass("active")" asp-controller="Admin" asp-action="Index" asp-route-status="Active">
                <span><i class="bi bi-person-check me-2"></i>Активные</span>
                <span class="@BadgeClass("active")">@countActive</span>
            </a>
            <a class="@CategoryClass("banned")" asp-controller="Admin" asp-action="Index" asp-route-status="Banned">
                <span><i class="bi bi-slash-circle me-2"></i>Заблокированные</span>
                <span class="@BadgeClass("banned")">@countBanned</span>
            </a>
            <a class="@CategoryClass("deleted")" asp-controller="Admin" asp-action="Index" asp-route-status="Deleted">
                <span><i class="bi bi-person-x me-2"></i>Удалённые</span>
                <span class="@BadgeClass("deleted")">@countDeleted</span>
            </a>
            <a class="@CategoryClass("admin")" asp-controller="Admin" asp-action="Index" asp-route-status="Admin">
                <span><i class="bi bi-shield-lock me-2"></i>Администраторы</span>
                <span class="@BadgeClass("admin")">@countAdmin</span>
            </a>
        </div>

        <h6 class="text-uppercase text-muted small fw-bold mt-4 mb-2 px-1">Модерация</h6>
        <div class="list-group list-group-flush">
            <a class="@CategoryClass("reports")" asp-controller="Admin" asp-action="Reports">
                <span><i class="bi bi-flag me-2"></i>Жалобы</span>
                <span class="@(active == "reports" ? "badge bg-white text-primary" : "badge bg-warning text-dark")">@pendingReports</span>
            </a>
            <a class="@CategoryClass("appeals")" asp-controller="Admin" asp-action="Appeals">
                <span><i class="bi bi-megaphone me-2"></i>Апелляции</span>
                <span class="@(active == "appeals" ? "badge bg-white text-primary" : "badge bg-info text-dark")">@pendingAppeals</span>
            </a>
        </div>
    </div>
</div>
