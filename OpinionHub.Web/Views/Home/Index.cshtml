@model IEnumerable<OpinionHub.Web.Models.Poll>
@{
    ViewData["Title"] = "Лента";
}

<div class="container oh-page oh-page--wide">
    <div class="oh-page-header">
        <div>
            <h1 class="h3 oh-page-title">
                <i class="bi bi-collection"></i>Активные опросы
            </h1>
            <p class="oh-page-subtitle mb-0">Голосуй, обсуждай, создавай свои.</p>
        </div>
        <a asp-controller="Polls" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Создать опрос
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5" id="no-polls-msg">
            <i class="bi bi-inboxes text-muted" style="font-size: 3rem;"></i>
            <p class="text-secondary fs-5 mt-3 mb-0">Пока нет ни одного активного опроса.<br />Будьте первым!</p>
        </div>
    }
    else
    {
        <div class="poll-masonry" id="poll-feed-container">
            @foreach (var poll in Model)
            {
                <div class="card border-0 shadow-sm oh-card oh-card--compact is-hoverable overflow-hidden" id="poll-card-@poll.Id">

                    @if (!string.IsNullOrEmpty(poll.CoverImagePath))
                    {
                        <img src="@poll.CoverImagePath" class="card-img-top" style="aspect-ratio: 16/9; object-fit: cover;" alt="Обложка">
                    }

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-2">@poll.Title</h5>

                        <div class="mt-auto">
                            <div class="d-flex align-items-center mb-2 small">
                                @await Html.PartialAsync("_PollAuthor",
                                    new OpinionHub.Web.ViewModels.PollAuthorLinkViewModel(poll.IsAnonymousAuthor, poll.Author?.UserName, poll.Author?.AvatarPath))
                            </div>

                            <a asp-controller="Polls" asp-action="Details" asp-route-id="@poll.Id"
                               class="btn btn-outline-primary btn-sm w-100 fw-semibold">
                                Голосовать
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/poll-feed.js" asp-append-version="true"></script>
}
