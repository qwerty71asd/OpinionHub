@model OpinionHub.Web.ViewModels.UserListViewModel
@{
    ViewData["Title"] = $"{Model.Title} · {Model.TargetUserName}";
}

<div class="container oh-page oh-page--wide">
    <div class="oh-page-header">
        <div>
            <h1 class="h4 oh-page-title mb-1">@Model.Title</h1>
            <div class="text-secondary small">
                <a asp-action="Index" asp-route-userName="@Model.TargetUserName"
                   class="text-decoration-none">← @Model.TargetUserName</a>
            </div>
        </div>
        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">@Model.Users.Count</span>
    </div>

    @if (Model.Users.Count == 0)
    {
        <div class="text-center py-5 border rounded-4 bg-body-tertiary">
            <p class="text-secondary mb-0">Список пуст.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var user in Model.Users)
            {
                <div class="col-md-6 col-lg-4">
                    <a asp-action="Index" asp-route-userName="@user.UserName"
                       class="card border-0 shadow-sm oh-card oh-card--compact text-decoration-none text-body h-100 is-hoverable">
                        <div class="card-body d-flex align-items-center gap-3">
                            @await Html.PartialAsync("_UserAvatar",
                                new OpinionHub.Web.ViewModels.UserAvatarViewModel(user.UserName, user.AvatarPath, 48))
                            <div class="flex-grow-1" style="min-width:0;">
                                <div class="fw-semibold text-truncate">@user.UserName</div>
                            </div>
                            <i class="bi bi-chevron-right text-secondary"></i>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
