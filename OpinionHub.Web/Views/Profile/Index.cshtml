@model OpinionHub.Web.ViewModels.ProfilePublicViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = $"Профиль {Model.UserName}";
    var afTokens = Antiforgery.GetAndStoreTokens(Context);
}

<div class="container oh-page oh-page--wide">
    <div class="oh-page-header align-items-start">
        <div class="d-flex align-items-start gap-3" style="min-width:0;">
            @await Html.PartialAsync("_UserAvatar",
                new OpinionHub.Web.ViewModels.UserAvatarViewModel(Model.UserName, Model.AvatarPath, 80))
            <div style="min-width:0;">
                <h1 class="h3 oh-page-title mb-1 text-truncate">@Model.UserName</h1>

                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <p class="text-body mb-2" style="white-space:pre-wrap; word-break:break-word;">@Model.Bio</p>
                }

                <div class="d-flex flex-wrap gap-3 small text-secondary">
                    <a asp-action="Subscribers" asp-route-userName="@Model.UserName"
                       class="text-decoration-none text-body-secondary">
                        <i class="bi bi-people me-1"></i>
                        <span id="subscribers-count" class="fw-semibold text-body">@Model.SubscribersCount</span>
                        подписчиков
                    </a>
                    <a asp-action="Subscriptions" asp-route-userName="@Model.UserName"
                       class="text-decoration-none text-body-secondary">
                        <i class="bi bi-person-plus me-1"></i>
                        <span class="fw-semibold text-body">@Model.SubscriptionsCount</span>
                        подписок
                    </a>
                    <span>
                        <i class="bi bi-list-check me-1"></i>
                        <span class="fw-semibold text-body">@Model.Polls.Count</span>
                        опросов
                    </span>
                </div>
            </div>
        </div>

        <div>
            @if (Model.IsOwnProfile)
            {
                <a asp-area="Identity" asp-page="/Account/Manage/Profile"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-pencil me-1"></i>Редактировать профиль
                </a>
            }
            else if (!Model.IsViewerAuthenticated)
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-sm">
                    Войти, чтобы подписаться
                </a>
            }
            else
            {
                <button id="subscribe-btn"
                        type="button"
                        class="btn @(Model.IsSubscribed ? "btn-outline-primary" : "btn-primary")"
                        data-username="@Model.UserName"
                        data-subscribed="@(Model.IsSubscribed ? "true" : "false")">
                    <i class="bi @(Model.IsSubscribed ? "bi-person-dash" : "bi-person-plus") me-1"></i>
                    <span class="subscribe-label">@(Model.IsSubscribed ? "Отписаться" : "Подписаться")</span>
                </button>
            }
        </div>
    </div>

    <ul class="nav nav-pills mb-3 gap-2" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-polls" type="button" role="tab">
                <i class="bi bi-list-check me-2"></i>Опросы (@Model.Polls.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-voted" type="button" role="tab">
                <i class="bi bi-pie-chart me-2"></i>Участвовал(а)@(Model.CanSeeVotedPolls ? $" ({Model.VotedPolls.Count})" : "")
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-liked" type="button" role="tab">
                <i class="bi bi-heart me-2"></i>Лайкнутые@(Model.CanSeeLikedPolls ? $" ({Model.LikedPolls.Count})" : "")
            </button>
        </li>
    </ul>

    <div class="tab-content pt-2">
        @* === Свои опросы === *@
        <div class="tab-pane fade show active" id="tab-polls" role="tabpanel">
            @if (!Model.Polls.Any())
            {
                <div class="text-center py-5 border rounded-4 bg-body-tertiary">
                    <p class="text-secondary mb-0">У пользователя пока нет опросов.</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var poll in Model.Polls)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm oh-card oh-card--compact @(poll.IsDeleted ? "opacity-75" : "")">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div class="me-2" style="min-width:0;">
                                        <h6 class="mb-1 text-truncate">@poll.Title</h6>
                                        <div class="d-flex gap-2 flex-wrap small">
                                            <span class="badge rounded-pill @(poll.Status == PollStatus.Active ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning")">
                                                @poll.Status
                                            </span>
                                            @if (poll.IsDeleted)
                                            {
                                                <span class="badge rounded-pill bg-danger-subtle text-danger" title="Опрос удалён автором">
                                                    <i class="bi bi-trash me-1"></i>Удалён
                                                </span>
                                            }
                                            <span class="text-secondary">@poll.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                        </div>
                                    </div>
                                    <a asp-controller="Polls" asp-action="Details" asp-route-id="@poll.Id" class="btn btn-sm btn-link text-decoration-none flex-shrink-0">
                                        Открыть →
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* === Участвовал(а) === *@
        <div class="tab-pane fade" id="tab-voted" role="tabpanel">
            @if (Model.VotedHiddenByOwner)
            {
                <div class="text-center py-5 border rounded-4 bg-body-tertiary">
                    <i class="bi bi-eye-slash text-secondary" style="font-size:2rem;"></i>
                    <p class="text-secondary mb-0 mt-2">Автор скрыл своё участие в опросах.</p>
                </div>
            }
            else if (!Model.VotedPolls.Any())
            {
                <div class="text-center py-5 border rounded-4 bg-body-tertiary">
                    <p class="text-secondary mb-0">Пользователь ещё не участвовал в голосованиях.</p>
                </div>
            }
            else
            {
                @if (Model.IsOwnProfile && !Model.CanSeeVotedPolls)
                {
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="bi bi-eye-slash me-1"></i>
                        Эта вкладка скрыта от других. Включить показ — в <a asp-area="Identity" asp-page="/Account/Manage/Privacy">настройках приватности</a>.
                    </div>
                }
                <div class="row g-3">
                    @foreach (var poll in Model.VotedPolls)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm oh-card oh-card--compact border-start border-primary border-4 @(poll.IsDeleted ? "opacity-75" : "")">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div class="me-2" style="min-width:0;">
                                        <h6 class="mb-1 text-truncate">@poll.Title</h6>
                                        <div class="small text-secondary d-flex align-items-center gap-1 flex-wrap">
                                            <span>Автор:</span>
                                            @await Html.PartialAsync("_PollAuthor", new OpinionHub.Web.ViewModels.PollAuthorLinkViewModel(poll.IsAnonymousAuthor, poll.Author?.UserName, poll.Author?.AvatarPath))
                                            @if (poll.IsDeleted)
                                            {
                                                <span class="badge rounded-pill bg-danger-subtle text-danger ms-2">
                                                    <i class="bi bi-trash me-1"></i>Удалён
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <a asp-controller="Polls" asp-action="Details" asp-route-id="@poll.Id" class="btn btn-sm btn-link text-decoration-none flex-shrink-0">
                                        Результаты →
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* === Лайкнутые === *@
        <div class="tab-pane fade" id="tab-liked" role="tabpanel">
            @if (Model.LikedHiddenByOwner)
            {
                <div class="text-center py-5 border rounded-4 bg-body-tertiary">
                    <i class="bi bi-eye-slash text-secondary" style="font-size:2rem;"></i>
                    <p class="text-secondary mb-0 mt-2">Автор скрыл свои лайки.</p>
                </div>
            }
            else if (!Model.LikedPolls.Any())
            {
                <div class="text-center py-5 border rounded-4 bg-body-tertiary">
                    <p class="text-secondary mb-0">Пользователь ещё ничего не лайкнул.</p>
                </div>
            }
            else
            {
                @if (Model.IsOwnProfile && !Model.CanSeeLikedPolls)
                {
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="bi bi-eye-slash me-1"></i>
                        Эта вкладка скрыта от других. Включить показ — в <a asp-area="Identity" asp-page="/Account/Manage/Privacy">настройках приватности</a>.
                    </div>
                }
                <div class="row g-3">
                    @foreach (var poll in Model.LikedPolls)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm oh-card oh-card--compact border-start border-danger border-4">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div class="me-2" style="min-width:0;">
                                        <h6 class="mb-1 text-truncate">
                                            <i class="bi bi-heart-fill text-danger me-1"></i>@poll.Title
                                        </h6>
                                        <div class="small text-secondary d-flex align-items-center gap-1 flex-wrap">
                                            <span>Автор:</span>
                                            @await Html.PartialAsync("_PollAuthor", new OpinionHub.Web.ViewModels.PollAuthorLinkViewModel(poll.IsAnonymousAuthor, poll.Author?.UserName, poll.Author?.AvatarPath))
                                        </div>
                                    </div>
                                    <a asp-controller="Polls" asp-action="Details" asp-route-id="@poll.Id" class="btn btn-sm btn-link text-decoration-none flex-shrink-0">
                                        Открыть →
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (!Model.IsOwnProfile && Model.IsViewerAuthenticated)
{
    <input type="hidden" id="af-token" value="@afTokens.RequestToken" />

    @section Scripts {
        <script>
            (function () {
                const btn = document.getElementById('subscribe-btn');
                if (!btn) return;

                const tokenEl = document.getElementById('af-token');
                const counterEl = document.getElementById('subscribers-count');
                const labelEl = btn.querySelector('.subscribe-label');
                const iconEl = btn.querySelector('i');
                const targetUser = btn.dataset.username;
                const url = '/api/subscriptions/' + encodeURIComponent(targetUser);

                btn.addEventListener('click', async function () {
                    const isSubscribed = btn.dataset.subscribed === 'true';
                    btn.disabled = true;

                    try {
                        const resp = await fetch(url, {
                            method: isSubscribed ? 'DELETE' : 'POST',
                            headers: {
                                'RequestVerificationToken': tokenEl.value,
                                'Accept': 'application/json'
                            },
                            credentials: 'same-origin'
                        });
                        if (!resp.ok) {
                            const text = await resp.text();
                            console.error('Subscribe error:', resp.status, text);
                            return;
                        }
                        const data = await resp.json();

                        btn.dataset.subscribed = data.isSubscribed ? 'true' : 'false';
                        if (data.isSubscribed) {
                            btn.classList.remove('btn-primary');
                            btn.classList.add('btn-outline-primary');
                            labelEl.textContent = 'Отписаться';
                            iconEl.classList.remove('bi-person-plus');
                            iconEl.classList.add('bi-person-dash');
                        } else {
                            btn.classList.remove('btn-outline-primary');
                            btn.classList.add('btn-primary');
                            labelEl.textContent = 'Подписаться';
                            iconEl.classList.remove('bi-person-dash');
                            iconEl.classList.add('bi-person-plus');
                        }
                        if (typeof data.subscribersCount === 'number') {
                            counterEl.textContent = data.subscribersCount;
                        }
                    } catch (err) {
                        console.error('Subscribe network error:', err);
                    } finally {
                        btn.disabled = false;
                    }
                });
            })();
        </script>
    }
}
